@model ProductDto
@{
    ViewData["Title"] = Loc.T("Products_SearchTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);

    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string dt = "text-[11.5px] font-semibold tracking-wide text-ink-faint";
}

<div class="mx-auto max-w-[52rem]">
    <header class="mb-5 border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Products_SearchHeading")</h1>
    </header>

    <form asp-area="Catalog" asp-controller="Products" asp-action="SearchByName" method="get"
          class="mb-5 rounded-lg border border-line bg-surface p-5 shadow-card">
        <div class="flex flex-wrap items-end gap-3">
            <div class="min-w-[220px] flex-1">
                <label for="q-name" class="@label">@T("Products_Name")</label>
                <input id="q-name" name="name" value="@Context.Request.Query["name"]" class="@input" placeholder="@T("Products_SearchPlaceholder")" />
            </div>
            <button type="submit" class="@btnPrimary">
                <svg class="icon !size-4"><use href="#i-search" /></svg>@T("Common_Search")
            </button>
        </div>

        @if (ViewBag.NotFound != null)
        {
            <div class="mt-4 flex items-start gap-3 rounded-md border border-warn/30 bg-warn-tint px-4 py-3 text-[13px] text-warn">
                <svg class="icon mt-0.5 !size-4 shrink-0"><use href="#i-alert" /></svg><span>@ViewBag.NotFound</span>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="mt-4 flex items-start gap-3 rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger">
                <svg class="icon mt-0.5 !size-4 shrink-0"><use href="#i-alert" /></svg><span>@ViewBag.Error</span>
            </div>
        }
    </form>

    @if (Model != null)
    {
        <div class="rounded-lg border border-line bg-surface shadow-card">
            <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
                <svg class="icon !size-[18px] text-accent"><use href="#i-box" /></svg>
                <span class="text-[14px] font-semibold text-ink">@Model.Name</span>
            </div>
            <dl class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2 lg:grid-cols-3">
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Id")</dt>
                    <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.Id</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Products_CategoryId")</dt>
                    <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.CategoryId</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Barcode")</dt>
                    <dd class="num mt-1 font-mono text-[13.5px] font-semibold text-ink">@Model.Barcode</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Price")</dt>
                    <dd class="num mt-1 text-[16px] font-bold text-ink">@Model.Price.ToString("N2")</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Status")</dt>
                    <dd class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@T("Common_Active")</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@T("Common_Inactive")</span>
                        }
                    </dd>
                </div>
            </dl>
            <div class="flex flex-wrap gap-2 border-t border-line bg-sunken/30 px-5 py-4">
                <a class="@btnPrimary" asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@T("Common_ViewDetails")</a>
                <a class="@btnGhost" asp-area="Catalog" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id">@T("Common_Edit")</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Context.Request.Query["name"]) && ViewBag.NotFound == null)
    {
        <div class="rounded-lg border border-dashed border-line-strong px-6 py-12 text-center">
            <svg class="icon mx-auto !size-7 text-ink-faint"><use href="#i-search" /></svg>
            <p class="mt-2 text-[13.5px] text-ink-soft">@T("Products_SearchEmpty")</p>
        </div>
    }

    <div class="mt-5">
        <a class="@btnGhost" asp-area="Catalog" asp-controller="Products" asp-action="Index">
            <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Common_BackToList")
        </a>
    </div>
</div>
