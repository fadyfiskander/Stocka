@model IEnumerable<ProductDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Products_Title");
    string T(string key) => Loc.T(key);

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string rowBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-2.5 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
            <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Products_Title")</h1>
            <p class="mt-1.5 text-[13.5px] text-ink-soft">@T("Products_Sub")</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a class="@btnGhost" asp-area="Catalog" asp-controller="Products" asp-action="SearchByName">
                <svg class="icon !size-4"><use href="#i-search" /></svg>@T("Products_SearchByName")
            </a>
            <a class="@btnPrimary" asp-area="Catalog" asp-controller="Products" asp-action="Create">
                <svg class="icon !size-4"><use href="#i-plus" /></svg>@T("Products_Add")
            </a>
        </div>
    </header>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Name")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Barcode")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Common_Price")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Status")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Common_Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var product in Model)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-ink">@product.Name</div>
                                    <div class="num mt-0.5 font-mono text-[11.5px] text-ink-faint">@product.Id.ToString().Substring(0, 8)…</div>
                                </td>
                                <td class="px-4 py-3"><span class="num font-mono text-[12.5px] text-ink-soft">@product.Barcode</span></td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@product.Price.ToString("N2")</td>
                                <td class="px-4 py-3">
                                    @if (product.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@T("Common_Active")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@T("Common_Inactive")</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-end gap-1.5">
                                        <a class="@rowBtn" asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@T("Common_Details")</a>
                                        <a class="@rowBtn" asp-area="Catalog" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">@T("Common_Edit")</a>
                                        @if (product.IsActive)
                                        {
                                            <form asp-area="Catalog" asp-controller="Products" asp-action="Deactivate" asp-route-id="@product.Id" method="post" class="inline-flex">
                                                <button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-warn/35 bg-transparent px-2.5 text-[12.5px] font-medium text-warn transition-colors hover:bg-warn-tint">@T("Common_Deactivate")</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Catalog" asp-controller="Products" asp-action="Activate" asp-route-id="@product.Id" method="post" class="inline-flex">
                                                <button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-ok/35 bg-transparent px-2.5 text-[12.5px] font-medium text-ok transition-colors hover:bg-ok-tint">@T("Common_Activate")</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-14 text-center">
                                <svg class="icon mx-auto !size-8 text-ink-faint"><use href="#i-box" /></svg>
                                <p class="mt-2 text-[14px] font-semibold text-ink">@T("Products_Empty")</p>
                                <p class="mx-auto mt-1 max-w-[46ch] text-[12.5px] text-ink-soft">@T("Products_EmptyHint")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
