@model IEnumerable<ProductDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Products_Title");
    string T(string key) => Loc.T(key);
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@T("Products_Title")</h2>
            <p class="text-muted mb-0">@T("Products_Sub")</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-area="Catalog" asp-controller="Products" asp-action="SearchByName">@T("Products_SearchByName")</a>
            <a class="btn btn-primary" asp-area="Catalog" asp-controller="Products" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> @T("Products_Add")
            </a>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@T("Common_Name")</th>
                            <th>@T("Common_Barcode")</th>
                            <th>@T("Common_Price")</th>
                            <th>@T("Common_Status")</th>
                            <th class="pe-4 text-end">@T("Common_Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@product.Name</div>
                                        <small class="text-muted font-monospace">@product.Id.ToString().Substring(0,8)...</small>
                                    </td>
                                    <td>
                                        <span class="text-muted">@product.Barcode</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@product.Price.ToString("N2") $</span>
                                    </td>
                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge text-bg-success">@T("Common_Active")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@T("Common_Inactive")</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@T("Common_Details")</a>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-area="Catalog" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">@T("Common_Edit")</a>
                                            @if (product.IsActive)
                                            {
                                                <form asp-area="Catalog" asp-controller="Products" asp-action="Deactivate" asp-route-id="@product.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">@T("Common_Deactivate")</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Catalog" asp-controller="Products" asp-action="Activate" asp-route-id="@product.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">@T("Common_Activate")</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-5 text-center">
                                    <div class="text-muted">
                                        <div class="fs-4 mb-2">@T("Products_Empty")</div>
                                        <small>@T("Products_EmptyHint")</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
