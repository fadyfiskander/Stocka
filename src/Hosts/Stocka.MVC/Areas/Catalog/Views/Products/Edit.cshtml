@model UpdateProductCommand
@{
    ViewData["Title"] = Loc.T("Products_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h2 class="mb-1">@T("Products_EditTitle")</h2>
                <p class="text-muted mb-0">@T("Products_EditSub")</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-area="Catalog" asp-controller="Products" asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="ProductId" />

                        <div class="mb-3">
                            <label class="form-label text-muted small">@T("Products_Id")</label>
                            <div class="font-monospace small text-muted">@Model.ProductId</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@T("Products_Name")</label>
                            <input asp-for="Name" class="form-control" placeholder="@T("Products_NamePlaceholder")" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">@T("Products_Category")</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">@T("Products_KeepOrSelect")</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SellingPrice" class="form-label">@T("Products_SellingPrice")</label>
                            <div class="input-group">
                                <input asp-for="SellingPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                                <span class="input-group-text">$</span>
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Barcode" class="form-label">@T("Common_Barcode")</label>
                            <input asp-for="Barcode" class="form-control" placeholder="@T("Products_BarcodePlaceholder")" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImagePath" class="form-label">@T("Products_ImagePath")</label>
                            <input asp-for="ImagePath" class="form-control" placeholder="@T("Products_ImageHint")" />
                            <span asp-validation-for="ImagePath" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Catalog" asp-controller="Products" asp-action="Index" class="btn btn-light">@T("Common_Cancel")</a>
                            <a asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">@T("Common_Details")</a>
                            <button type="submit" class="btn btn-primary px-4">@T("Common_SaveChanges")</button>
                        </div>
                    </form>

                    <div class="alert alert-info mt-4 mb-0 small">
                        @T("Products_EditNote")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
