@model UpdateProductCommand
@{
    ViewData["Title"] = Loc.T("Products_EditTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);

    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string err = "mt-1.5 block text-[12px] font-medium text-danger";
}

<div class="mx-auto max-w-[46rem]">
    <header class="mb-5 border-b border-line pb-5">
        <h1 class="text-[24px] font-bold tracking-[-.02em]">@T("Products_EditTitle")</h1>
        <p class="mt-1.5 text-[13.5px] text-ink-soft">@T("Products_EditSub")</p>
    </header>

    <form asp-area="Catalog" asp-controller="Products" asp-action="Edit" method="post"
          class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="grid gap-5 p-5 sm:p-7">
            <div asp-validation-summary="ModelOnly" class="rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger empty:hidden"></div>

            <input type="hidden" asp-for="ProductId" />

            <div>
                <span class="@label">@T("Products_Id")</span>
                <div class="num break-all rounded-md border border-line bg-sunken px-3 py-2.5 font-mono text-[12.5px] text-ink-soft">@Model.ProductId</div>
            </div>

            <div>
                <label asp-for="Name" class="@label">@T("Products_Name")</label>
                <input asp-for="Name" class="@input" placeholder="@T("Products_NamePlaceholder")" />
                <span asp-validation-for="Name" class="@err"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="@label">@T("Products_Category")</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories"
                        class="block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]">
                    <option value="">@T("Products_KeepOrSelect")</option>
                </select>
                <span asp-validation-for="CategoryId" class="@err"></span>
            </div>

            <div>
                <label asp-for="SellingPrice" class="@label">@T("Products_SellingPrice")</label>
                <div class="flex items-stretch overflow-hidden rounded-md border border-line bg-surface transition focus-within:border-accent focus-within:ring-[3px] focus-within:ring-[var(--focus-ring)]">
                    <input asp-for="SellingPrice" type="number" step="0.01" min="0" placeholder="0.00"
                           class="num block h-10 min-w-0 flex-1 border-0 bg-transparent px-3 text-[13.5px] text-ink outline-none placeholder:text-ink-faint" />
                    <span class="grid place-items-center border-s border-line bg-sunken px-3 text-[12.5px] font-semibold text-ink-soft">EGP</span>
                </div>
                <span asp-validation-for="SellingPrice" class="@err"></span>
            </div>

            <div>
                <label asp-for="Barcode" class="@label">@T("Common_Barcode")</label>
                <input asp-for="Barcode" class="@input num font-mono" placeholder="@T("Products_BarcodePlaceholder")" />
                <span asp-validation-for="Barcode" class="@err"></span>
            </div>

            <div>
                <label asp-for="ImagePath" class="@label">@T("Products_ImagePath")</label>
                <input asp-for="ImagePath" class="@input num font-mono" placeholder="@T("Products_ImageHint")" />
                <span asp-validation-for="ImagePath" class="@err"></span>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-2.5 border-t border-line bg-sunken/40 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-7">
            <a asp-area="Catalog" asp-controller="Products" asp-action="Index"
               class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline sm:me-auto">
                @T("Common_Cancel")
            </a>
            <a asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
               class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline">
                @T("Common_Details")
            </a>
            <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover">
                @T("Common_SaveChanges")
            </button>
        </div>
    </form>

    <p class="mt-4 flex items-start gap-2.5 rounded-md border border-info/25 bg-info-tint px-4 py-3 text-[12.5px] leading-relaxed text-info">
        <svg class="icon mt-0.5 !size-4 shrink-0"><use href="#i-info" /></svg>
        <span>@T("Products_EditNote")</span>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
