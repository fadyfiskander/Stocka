@model UpdateProductCommand
@{
    ViewData["Title"] = (Loc.IsEn ? "Edit product" : "تعديل منتج");
    Layout = "~/Views/Shared/_Layout.cshtml";

    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string err = "mt-1.5 block text-[12px] font-medium text-danger";
}

<div class="mx-auto max-w-[46rem]">
    <header class="mb-5 border-b border-line pb-5">
        <h1 class="font-bold tracking-[-.02em] text-[24px]">@(Loc.IsEn ? "Edit product" : "تعديل منتج")</h1>
        <p class="mt-1.5 text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Leave a field empty to keep its current value." : "اترك الحقل فارغاً للإبقاء على القيمة الحالية.")</p>
    </header>

    <form asp-area="Catalog" asp-controller="Products" asp-action="Edit" method="post"
          class="shadow-card overflow-hidden rounded-lg border border-line bg-surface">
        <div class="grid gap-5 p-5 sm:p-7">
            <div asp-validation-summary="ModelOnly" class="rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger empty:hidden"></div>

            <input type="hidden" asp-for="ProductId" />

            <div>
                <span class="@label">@(Loc.IsEn ? "Product ID" : "معرّف المنتج")</span>
                <div class="num rounded-md border border-line bg-sunken px-3 py-2.5 font-mono break-all text-[12.5px] text-ink-soft">@Model.ProductId</div>
            </div>

            <div>
                <label asp-for="Name" class="@label">@(Loc.IsEn ? "Product name" : "اسم المنتج")</label>
                <input asp-for="Name" class="@input" placeholder="@(Loc.IsEn ? "Enter product name" : "أدخل اسم المنتج")" />
                <span asp-validation-for="Name" class="@err"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="@label">@(Loc.IsEn ? "Category" : "التصنيف")</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories"
                        class="block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink transition outline-none hover:border-line-strong focus:border-accent focus:ring-[var(--focus-ring)] focus:ring-[3px]">
                    <option value="">@(Loc.IsEn ? "-- Keep current / Select category --" : "-- الإبقاء على الحالي / اختر تصنيف --")</option>
                </select>
                <span asp-validation-for="CategoryId" class="@err"></span>
            </div>

            <div>
                <label asp-for="SellingPrice" class="@label">@(Loc.IsEn ? "Selling price" : "سعر البيع")</label>
                <div class="flex items-stretch overflow-hidden rounded-md border border-line bg-surface transition focus-within:border-accent focus-within:ring-[var(--focus-ring)] focus-within:ring-[3px]">
                    <input asp-for="SellingPrice" type="number" step="0.01" min="0" placeholder="0.00"
                           class="num block h-10 min-w-0 flex-1 border-0 bg-transparent px-3 text-[13.5px] text-ink outline-none placeholder:text-ink-faint" />
                    <span class="grid place-items-center border-s border-line bg-sunken px-3 font-semibold text-[12.5px] text-ink-soft">EGP</span>
                </div>
                <span asp-validation-for="SellingPrice" class="@err"></span>
            </div>

            <div>
                <label asp-for="Barcode" class="@label">@(Loc.IsEn ? "Barcode" : "الباركود")</label>
                <input asp-for="Barcode" class="@input num font-mono" placeholder="@(Loc.IsEn ? "Enter barcode" : "أدخل الباركود")" />
                <span asp-validation-for="Barcode" class="@err"></span>
            </div>

            <div>
                <label asp-for="ImagePath" class="@label">@(Loc.IsEn ? "Image path" : "مسار الصورة")</label>
                <input asp-for="ImagePath" class="@input num font-mono" placeholder="@(Loc.IsEn ? "e.g. /images/products/xyz.jpg — leave empty to keep current, empty string to clear" : "مثال: /images/products/xyz.jpg — اتركه فارغاً للإبقاء على الحالي، أو نصاً فارغاً للمسح")" />
                <span asp-validation-for="ImagePath" class="@err"></span>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-2.5 border-t border-line bg-sunken/40 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-7">
            <a asp-area="Catalog" asp-controller="Products" asp-action="Index"
               class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 font-medium text-[13.5px] text-ink transition-colors hover:bg-sunken hover:no-underline sm:me-auto">
                @(Loc.IsEn ? "Cancel" : "إلغاء")
            </a>
            <a asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
               class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 font-medium text-[13.5px] text-ink transition-colors hover:bg-sunken hover:no-underline">
                @(Loc.IsEn ? "Details" : "التفاصيل")
            </a>
            <button type="submit" class="text-on-accent inline-flex h-9 items-center justify-center rounded-md bg-accent px-5 font-semibold text-[13.5px] transition-colors hover:bg-accent-hover">
                @(Loc.IsEn ? "Save changes" : "حفظ التغييرات")
            </button>
        </div>
    </form>

    <p class="mt-4 flex items-start gap-2.5 rounded-md border border-info/25 bg-info-tint px-4 py-3 leading-relaxed text-[12.5px] text-info">
        <icon name="info" class="mt-0.5 !size-4 shrink-0" />
        <span>@(Loc.IsEn ? "At least one field must be provided. Empty fields will keep their previous values. For Barcode/ImagePath, submitting an empty string will explicitly clear the value (depending on domain logic)." : "يجب توفير حقل واحد على الأقل. الحقول الفارغة تحتفظ بقيمها السابقة. بالنسبة للباركود/مسار الصورة، إرسال نص فارغ يمسح القيمة (حسب منطق النطاق).")</span>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
