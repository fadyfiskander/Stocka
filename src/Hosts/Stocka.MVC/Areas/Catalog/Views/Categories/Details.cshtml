@model CategoryDto
@{
    ViewData["Title"] = Loc.T("Categories_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">@T("Categories_DetailsTitle")</h2>
                </div>
                <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-light">@T("Common_BackToList")</a>
            </div>

            @if (Model == null)
            {
                <div class="alert alert-warning">@T("Categories_NotFound")</div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">@T("Common_Id")</label>
                                <div class="fw-semibold font-monospace small">@Model.Id</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">@T("Common_OrganizationId")</label>
                                <div class="fw-semibold font-monospace small">@Model.OrganizationId</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">@T("Common_Name")</label>
                                <div class="fw-semibold fs-5">@Model.Name</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">@T("Common_Status")</label>
                                <div>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge text-bg-success fs-6">@T("Common_Active")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary fs-6">@T("Common_Inactive")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@T("Common_Edit")</a>

                            @if (Model.IsActive)
                            {
                                <form asp-area="Catalog" asp-controller="Categories" asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-warning">@T("Common_Deactivate")</button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="Catalog" asp-controller="Categories" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-success">@T("Common_Activate")</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
