@model CategoryDto
@{
    ViewData["Title"] = Loc.T("Categories_DetailsTitle");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string dt = "text-[11.5px] font-semibold tracking-wide text-ink-faint";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Categories_DetailsTitle")</h1>
        <a class="@btnGhost" asp-area="Catalog" asp-controller="Categories" asp-action="Index">
            <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Common_BackToList")
        </a>
    </header>

    @if (Model == null)
    {
        <div class="flex items-start gap-3 rounded-md border border-warn/30 bg-warn-tint px-4 py-3 text-[13.5px] text-warn">
            <svg class="icon mt-0.5 !size-[17px]"><use href="#i-alert" /></svg>
            <span>@T("Categories_NotFound")</span>
        </div>
    }
    else
    {
        <div class="rounded-lg border border-line bg-surface shadow-card">
            <dl class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2 sm:p-6">
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Id")</dt>
                    <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.Id</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_OrganizationId")</dt>
                    <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.OrganizationId</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Name")</dt>
                    <dd class="mt-1 text-[18px] font-bold tracking-[-.01em] text-ink">@Model.Name</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@T("Common_Status")</dt>
                    <dd class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[12px] font-semibold text-ok">@T("Common_Active")</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 text-[12px] font-semibold text-ink-soft">@T("Common_Inactive")</span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="flex flex-wrap items-center justify-end gap-2 border-t border-line bg-sunken/30 px-5 py-4 sm:px-6">
                <a class="@btnPrimary" asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id">
                    <svg class="icon !size-4"><use href="#i-pencil" /></svg>@T("Common_Edit")
                </a>
                @if (Model.IsActive)
                {
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-warn/35 bg-transparent px-4 text-[13.5px] font-medium text-warn transition-colors hover:bg-warn-tint">@T("Common_Deactivate")</button>
                    </form>
                }
                else
                {
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-ok/35 bg-transparent px-4 text-[13.5px] font-medium text-ok transition-colors hover:bg-ok-tint">@T("Common_Activate")</button>
                    </form>
                }
            </div>
        </div>
    }
</section>
