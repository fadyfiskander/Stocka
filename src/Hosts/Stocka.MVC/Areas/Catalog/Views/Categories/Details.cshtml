@model CategoryDto
@{
    ViewData["Title"] = (Loc.IsEn ? "Category details" : "تفاصيل التصنيف");
    Layout = "~/Views/Shared/_Layout.cshtml";

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string dt = "text-[11.5px] font-semibold tracking-wide text-ink-faint";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <h1 class="font-bold tracking-[-.015em] text-[22px]">@(Loc.IsEn ? "Category details" : "تفاصيل التصنيف")</h1>
        <a class="@btnGhost" asp-area="Catalog" asp-controller="Categories" asp-action="Index">
            <icon name="chevron-left" class="!size-4 scale-x-[var(--dir-flip)]" />@(Loc.IsEn ? "Back to list" : "العودة للقائمة")
        </a>
    </header>

    @if (Model == null)
    {
        <div class="flex items-start gap-3 rounded-md border border-warn/30 bg-warn-tint px-4 py-3 text-[13.5px] text-warn">
            <icon name="alert-triangle" class="mt-0.5 !size-[17px]" />
            <span>@(Loc.IsEn ? "Category not found." : "التصنيف غير موجودة.")</span>
        </div>
    }
    else
    {
        <div class="shadow-card rounded-lg border border-line bg-surface">
            <dl class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2 sm:p-6">
                <div class="min-w-0">
                    <dt class="@dt">@(Loc.IsEn ? "ID" : "المعرّف")</dt>
                    <dd class="num mt-1 font-mono break-all text-[12.5px] text-ink-soft">@Model.Id</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@(Loc.IsEn ? "Organization ID" : "معرّف المؤسسة")</dt>
                    <dd class="num mt-1 font-mono break-all text-[12.5px] text-ink-soft">@Model.OrganizationId</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@(Loc.IsEn ? "Name" : "الاسم")</dt>
                    <dd class="mt-1 font-bold tracking-[-.01em] text-[18px] text-ink">@Model.Name</dd>
                </div>
                <div class="min-w-0">
                    <dt class="@dt">@(Loc.IsEn ? "Status" : "الحالة")</dt>
                    <dd class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 font-semibold text-[12px] text-ok">@(Loc.IsEn ? "Active" : "نشط")</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 font-semibold text-[12px] text-ink-soft">@(Loc.IsEn ? "Inactive" : "غير نشط")</span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="flex flex-wrap items-center justify-end gap-2 border-t border-line bg-sunken/30 px-5 py-4 sm:px-6">
                <a class="@btnPrimary" asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id">
                    <icon name="pencil" class="!size-4" />@(Loc.IsEn ? "Edit" : "تعديل")
                </a>
                @if (Model.IsActive)
                {
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-warn/35 bg-transparent px-4 font-medium text-[13.5px] text-warn transition-colors hover:bg-warn-tint">@(Loc.IsEn ? "Deactivate" : "إيقاف")</button>
                    </form>
                }
                else
                {
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-ok/35 bg-transparent px-4 font-medium text-[13.5px] text-ok transition-colors hover:bg-ok-tint">@(Loc.IsEn ? "Activate" : "تفعيل")</button>
                    </form>
                }
            </div>
        </div>
    }
</section>
