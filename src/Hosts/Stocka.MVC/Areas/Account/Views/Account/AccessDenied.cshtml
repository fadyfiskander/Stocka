@{
    ViewData["Title"] = Loc.T("Denied_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);
}

<div class="mx-auto max-w-[46ch] py-10 text-center">
    <span class="mx-auto grid size-16 place-items-center rounded-xl border border-line bg-surface text-ink-faint shadow-card">
        <svg class="icon !size-[30px]"><use href="#i-archive" /></svg>
    </span>
    <h1 class="mt-5 text-[22px] font-bold tracking-[-.015em]">@T("Denied_Heading")</h1>
    <p class="mx-auto mt-2.5 text-[13.5px] leading-relaxed text-ink-soft">@T("Denied_Text")</p>
    <a class="mt-6 inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline"
       asp-area="" asp-controller="Home" asp-action="Index">@T("Denied_BackHome")</a>
</div>
