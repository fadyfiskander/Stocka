@{
    ViewData["Title"] = Loc.T("Denied_Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="mb-3">
                <span class="display-1" aria-hidden="true">🔒</span>
            </div>
            <h2 class="mb-2">@T("Denied_Heading")</h2>
            <p class="text-muted mb-4">
                @T("Denied_Text")
            </p>

            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">@T("Denied_BackHome")</a>
        </div>
    </div>
</div>
