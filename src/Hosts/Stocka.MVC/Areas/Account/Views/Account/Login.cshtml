@model Stocka.MVC.Areas.Account.Models.LoginViewModel
@{
    ViewData["Title"] = Loc.T("Login_Title");
    Layout = "~/Areas/Account/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);
}

<main class="auth-page">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-form-panel">
            <a class="auth-mark auth-mark--mobile" href="/" aria-label="@T("Login_Home")">
                <span class="auth-mark__icon" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="auth-heading">
                <p class="auth-eyebrow">@T("Login_Eyebrow")</p>
                <h1 id="login-title">@T("Login_Title")</h1>
                <p>@T("Login_Sub")</p>
            </div>

            <form class="auth-form"
                  data-validate
                  asp-area="Account"
                  asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">
                <div asp-validation-summary="ModelOnly" class="form-error-summary" role="alert"></div>

                <div class="form-field">
                    <label asp-for="Email">@T("Login_Email")</label>
                    <input asp-for="Email"
                           autocomplete="email"
                           placeholder="@T("Login_EmailPlaceholder")"
                           autofocus />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password">@T("Login_Password")</label>
                    <input asp-for="Password"
                           autocomplete="current-password"
                           placeholder="@T("Login_PasswordPlaceholder")" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-options">
                    <label class="remember-option">
                        <input asp-for="RememberMe" />
                        <span>@T("Login_Remember")</span>
                    </label>
                    <span asp-validation-for="RememberMe" class="field-error"></span>
                </div>

                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit" class="auth-submit">
                    <span>@T("Login_Submit")</span>
                    <span class="auth-submit-arrow" aria-hidden="true">→</span>
                </button>
            </form>

            <p class="auth-footer">@T("Login_Footer")</p>
        </div>

        <aside class="auth-showcase" aria-label="@T("Login_Overview")">
            <a class="auth-mark" href="/" aria-label="@T("Login_Home")">
                <span class="auth-mark__icon" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="showcase-content">
                <p class="showcase-kicker">@T("Login_ShowcaseKicker")</p>
                <h2>@T("Login_ShowcaseTitle")</h2>
                <p>@T("Login_ShowcaseText")</p>
            </div>

            <div class="showcase-status">
                <span class="status-dot" aria-hidden="true"></span>
                <span>@T("Login_ShowcaseStatus")</span>
            </div>
        </aside>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
