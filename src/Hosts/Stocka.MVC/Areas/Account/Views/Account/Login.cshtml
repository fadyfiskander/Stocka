@model Stocka.MVC.Areas.Account.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Areas/Account/Views/Shared/_Layout.cshtml";
}

<main class="auth-page">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-form-panel">
            <a class="auth-mark auth-mark--mobile" href="/" aria-label="Stocka home">
                <span class="auth-mark__icon" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="auth-heading">
                <p class="auth-eyebrow">Welcome back</p>
                <h1 id="login-title">Sign in to Stocka</h1>
                <p>Keep your inventory moving with a clear view of every item, order, and warehouse.</p>
            </div>

            <form class="auth-form"
                  asp-area="Account"
                  asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">
                <div asp-validation-summary="ModelOnly" class="form-error-summary" role="alert"></div>

                <div class="form-field">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email"
                           autocomplete="email"
                           placeholder="name@example.com"
                           autofocus />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password"
                           autocomplete="current-password"
                           placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-options">
                    <label class="remember-option">
                        <input asp-for="RememberMe" />
                        <span>Keep me signed in</span>
                    </label>
                    <span asp-validation-for="RememberMe" class="field-error"></span>
                </div>

                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit" class="auth-submit">
                    <span>Sign in</span>
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <p class="auth-footer">Secure access to your business operations</p>
        </div>

        <aside class="auth-showcase" aria-label="Stocka overview">
            <a class="auth-mark" href="/" aria-label="Stocka home">
                <span class="auth-mark__icon" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="showcase-content">
                <p class="showcase-kicker">Inventory, made visible</p>
                <h2>Make every unit count.</h2>
                <p>One calm workspace for the products and decisions that keep your business growing.</p>
            </div>

            <div class="showcase-status">
                <span class="status-dot" aria-hidden="true"></span>
                <span>Everything in its place</span>
            </div>
        </aside>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
