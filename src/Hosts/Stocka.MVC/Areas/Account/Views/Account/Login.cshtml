@model Stocka.MVC.Areas.Account.Models.LoginViewModel
@{
    ViewData["Title"] = Loc.T("Login_Title");
    Layout = "~/Areas/Account/Views/Shared/_Layout.cshtml";
    string T(string key) => Loc.T(key);

    const string label = "mb-2 block text-[13px] font-semibold text-ink";
    const string field = "block h-[52px] w-full rounded-[10px] border border-line bg-surface px-4 text-[14px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-4 focus:ring-[var(--focus-ring)]";
    const string err = "mt-1.5 block text-[12px] font-medium text-danger";
}

<main class="grid min-h-dvh place-items-center bg-grid p-6 max-lg:p-0">
    <section class="grid w-full max-w-[1040px] overflow-hidden rounded-[22px] border border-line bg-surface shadow-pop max-lg:min-h-dvh max-lg:max-w-none max-lg:rounded-none max-lg:border-0 max-lg:shadow-none lg:min-h-[640px] lg:grid-cols-[minmax(0,1.08fr)_minmax(340px,.92fr)]"
             aria-labelledby="login-title">

        @* ───────── Form panel ───────── *@
        <div class="flex flex-col justify-center px-[clamp(1.5rem,6vw,5.5rem)] py-10 max-lg:py-9">

            <a class="mb-auto inline-flex w-fit items-center gap-2.5 text-[1.05rem] font-bold tracking-[-.03em] text-accent hover:no-underline lg:hidden"
               href="/" aria-label="@T("Login_Home")">
                <span class="grid size-9 place-items-center rounded-[10px_10px_10px_3px] bg-accent-tint text-[1rem] font-extrabold text-accent" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="mt-14 max-w-[26rem] lg:mt-0">
                <p class="mb-3.5 text-[12.5px] font-semibold text-accent">@T("Login_Eyebrow")</p>
                <h1 id="login-title" class="text-[clamp(1.9rem,3vw,2.6rem)] font-bold leading-[1.06] tracking-[-.03em] text-ink">@T("Login_Title")</h1>
                <p class="mt-4 max-w-[24rem] text-[14px] leading-relaxed text-ink-soft">@T("Login_Sub")</p>
            </div>

            <form class="mt-8 w-full max-w-[26rem]" data-validate
                  asp-area="Account" asp-controller="Account" asp-action="Login"
                  asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" role="alert"
                     class="mb-5 rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[12.5px] text-danger empty:hidden"></div>

                <div class="mb-5">
                    <label asp-for="Email" class="@label">@T("Login_Email")</label>
                    <input asp-for="Email" autocomplete="email" placeholder="@T("Login_EmailPlaceholder")" autofocus class="@field" />
                    <span asp-validation-for="Email" class="@err"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Password" class="@label">@T("Login_Password")</label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="@T("Login_PasswordPlaceholder")" class="@field" />
                    <span asp-validation-for="Password" class="@err"></span>
                </div>

                <div class="mb-7 flex min-h-7 items-center justify-between">
                    <label class="inline-flex cursor-pointer items-center gap-2.5 text-[13px] text-ink-soft">
                        <input asp-for="RememberMe" class="size-[17px] cursor-pointer accent-accent" />
                        <span>@T("Login_Remember")</span>
                    </label>
                    <span asp-validation-for="RememberMe" class="@err"></span>
                </div>

                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit"
                        class="flex min-h-[54px] w-full items-center justify-between rounded-[10px] bg-accent px-5 text-[14px] font-bold text-on-accent transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                    <span>@T("Login_Submit")</span>
                    <svg class="icon !size-5 rtl:rotate-180" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 5.5 16 12l-6.5 6.5" /></svg>
                </button>
            </form>

            <p class="mb-auto mt-9 text-[11.5px] text-ink-faint">@T("Login_Footer")</p>
        </div>

        @* ───────── Showcase panel — the count sheet ───────── *@
        <aside class="relative hidden flex-col justify-between overflow-hidden bg-aside bg-grid p-11 text-aside-ink lg:flex"
               aria-label="@T("Login_Overview")">
            <a class="relative z-1 inline-flex w-fit items-center gap-2.5 text-[1.05rem] font-bold tracking-[-.03em] text-aside-ink hover:text-aside-ink hover:no-underline"
               href="/" aria-label="@T("Login_Home")">
                <span class="grid size-9 place-items-center rounded-[10px_10px_10px_3px] bg-aside-accent/15 text-[1rem] font-extrabold text-aside-accent" aria-hidden="true">S</span>
                <span>Stocka</span>
            </a>

            <div class="relative z-1 max-w-[19rem]">
                <p class="mb-3.5 text-[12.5px] font-semibold text-aside-accent">@T("Login_ShowcaseKicker")</p>
                <h2 class="text-[clamp(2.2rem,3.6vw,3.2rem)] font-bold leading-[1.02] tracking-[-.04em]">@T("Login_ShowcaseTitle")</h2>
                <p class="mt-5 max-w-[18rem] text-[14px] leading-relaxed text-aside-ink/70">@T("Login_ShowcaseText")</p>
            </div>

            <div class="relative z-1 flex items-center gap-2.5 text-[12px] text-aside-ink/70">
                <span class="size-2 rounded-full bg-aside-accent shadow-[0_0_0_5px_color-mix(in_srgb,var(--aside-accent)_16%,transparent)]" aria-hidden="true"></span>
                <span>@T("Login_ShowcaseStatus")</span>
            </div>
        </aside>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
