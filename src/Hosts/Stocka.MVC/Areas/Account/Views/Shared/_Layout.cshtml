@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@(string.IsNullOrWhiteSpace(title) ? "Stocka" : title + " · Stocka")</title>
    <style>
        :root {
            --ink: #17231f;
            --muted: #71807a;
            --line: #dce5df;
            --paper: #f5f8f5;
            --surface: #ffffff;
            --green: #1d765c;
            --green-deep: #155443;
            --mint: #dcefe5;
            --coral: #e88769;
            --shadow: 0 24px 70px rgba(28, 62, 49, .13);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            min-width: 320px;
            background: var(--paper);
        }

        body {
            min-width: 320px;
            min-height: 100vh;
            margin: 0;
            color: var(--ink);
            background: var(--paper);
            font-family: "Segoe UI", Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
        }

        button, input {
            font: inherit;
        }

        .auth-page {
            display: grid;
            min-height: 100vh;
            place-items: center;
            padding: 48px 24px;
            background:
                radial-gradient(circle at 8% 12%, rgba(220, 239, 229, .75), transparent 28%),
                radial-gradient(circle at 95% 88%, rgba(232, 135, 105, .13), transparent 25%);
        }

        .auth-card {
            display: grid;
            width: min(100%, 1030px);
            min-height: 650px;
            overflow: hidden;
            background: var(--surface);
            border: 1px solid rgba(220, 229, 223, .9);
            border-radius: 28px;
            box-shadow: var(--shadow);
        }

        .auth-form-panel {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 72px clamp(32px, 7vw, 88px);
        }

        .auth-showcase {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100%;
            padding: 48px 52px;
            overflow: hidden;
            color: #f7fbf8;
            background: var(--green-deep);
        }

        .auth-showcase::before,
        .auth-showcase::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(220, 239, 229, .18);
            border-radius: 50%;
        }

        .auth-showcase::before {
            width: 430px;
            height: 430px;
            right: -200px;
            top: -105px;
        }

        .auth-showcase::after {
            width: 280px;
            height: 280px;
            bottom: -155px;
            left: -100px;
            border-color: rgba(232, 135, 105, .35);
        }

        .auth-mark {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            gap: 11px;
            width: fit-content;
            color: inherit;
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -.03em;
            text-decoration: none;
        }

        .auth-mark__icon {
            display: grid;
            width: 34px;
            height: 34px;
            place-items: center;
            color: var(--green-deep);
            background: var(--mint);
            border-radius: 10px 10px 10px 3px;
            font-size: 1.1rem;
            font-weight: 800;
        }

        .auth-mark--mobile {
            display: none;
            color: var(--green-deep);
        }

        .auth-heading {
            max-width: 450px;
            margin-bottom: 38px;
        }

        .auth-eyebrow,
        .showcase-kicker {
            margin: 0 0 15px;
            color: var(--green);
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .auth-heading h1,
        .showcase-content h2 {
            margin: 0;
            letter-spacing: -.055em;
            line-height: 1.08;
        }

        .auth-heading h1 {
            font-size: clamp(2rem, 3.2vw, 2.8rem);
        }

        .auth-heading > p:last-child {
            max-width: 390px;
            margin: 18px 0 0;
            color: var(--muted);
            font-size: .98rem;
            line-height: 1.7;
        }

        .auth-form {
            width: min(100%, 410px);
        }

        .form-field {
            margin-bottom: 22px;
        }

        .form-field label {
            display: block;
            margin-bottom: 9px;
            color: var(--ink);
            font-size: .84rem;
            font-weight: 650;
        }

        .form-field input:not([type="checkbox"]) {
            width: 100%;
            height: 52px;
            padding: 0 16px;
            color: var(--ink);
            background: #fbfdfb;
            border: 1px solid var(--line);
            border-radius: 10px;
            outline: none;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .form-field input:not([type="checkbox"])::placeholder {
            color: #a4b0aa;
        }

        .form-field input:not([type="checkbox"]):focus {
            background: #fff;
            border-color: var(--green);
            box-shadow: 0 0 0 4px rgba(29, 118, 92, .12);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 28px;
            margin: 2px 0 28px;
        }

        .remember-option {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--muted);
            font-size: .83rem;
            cursor: pointer;
        }

        .remember-option input {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: var(--green);
        }

        .field-error,
        .form-error-summary {
            color: #b34937;
            font-size: .78rem;
        }

        .field-error {
            display: block;
            margin-top: 7px;
        }

        .form-error-summary {
            margin: 0 0 20px;
            padding: 13px 15px;
            background: #fff1ed;
            border: 1px solid #f4cfc5;
            border-radius: 9px;
        }

        .form-error-summary:empty {
            display: none;
        }

        .auth-submit {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            min-height: 54px;
            padding: 0 18px 0 22px;
            color: #fff;
            background: var(--green);
            border: 0;
            border-radius: 10px;
            cursor: pointer;
            font-size: .92rem;
            font-weight: 700;
            transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
        }

        .auth-submit span:last-child {
            color: var(--mint);
            font-size: 1.35rem;
            line-height: 1;
        }

        .auth-submit:hover,
        .auth-submit:focus-visible {
            background: #145e49;
            box-shadow: 0 8px 18px rgba(29, 118, 92, .2);
        }

        .auth-submit:active {
            transform: translateY(1px);
        }

        .auth-submit:focus-visible,
        .auth-mark:focus-visible,
        .remember-option input:focus-visible {
            outline: 3px solid rgba(232, 135, 105, .55);
            outline-offset: 3px;
        }

        .auth-footer {
            margin: 38px 0 0;
            color: #9aa8a1;
            font-size: .74rem;
        }

        .showcase-content {
            position: relative;
            z-index: 1;
            max-width: 320px;
            margin: auto 0;
        }

        .showcase-kicker {
            color: var(--coral);
        }

        .showcase-content h2 {
            max-width: 280px;
            font-size: clamp(2.4rem, 4vw, 3.5rem);
        }

        .showcase-content > p:last-child {
            max-width: 285px;
            margin: 24px 0 0;
            color: rgba(247, 251, 248, .7);
            font-size: .94rem;
            line-height: 1.75;
        }

        .showcase-status {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 9px;
            color: rgba(247, 251, 248, .72);
            font-size: .75rem;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--coral);
            border-radius: 50%;
            box-shadow: 0 0 0 5px rgba(232, 135, 105, .14);
        }

        @@media (min-width: 760px) {
            .auth-card {
                grid-template-columns: minmax(0, 1.1fr) minmax(330px, .9fr);
            }
        }

        @@media (max-width: 759px) {
            .auth-page {
                padding: 0;
            }

            .auth-card {
                min-height: 100vh;
                border: 0;
                border-radius: 0;
                box-shadow: none;
            }

            .auth-form-panel {
                padding: 36px 24px;
            }

            .auth-mark--mobile {
                display: inline-flex;
                margin-bottom: auto;
            }

            .auth-heading {
                margin-top: 74px;
            }

            .auth-showcase {
                display: none;
            }
        }

        @@media (max-width: 420px) {
            .auth-heading h1 {
                font-size: 2rem;
            }

            .auth-form-panel {
                padding-inline: 20px;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @RenderBody()
    @RenderSection("Scripts", required: false)
</body>
</html>