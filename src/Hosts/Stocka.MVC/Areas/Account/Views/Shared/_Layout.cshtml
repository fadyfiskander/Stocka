@{
    var title = ViewData["Title"] as string;
    var isRtl = Stocka.MVC.Localization.Loc.IsRtl;
    var htmlLang = Stocka.MVC.Localization.Loc.Language;
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@(isRtl ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrWhiteSpace(title) ? "Stocka" : title + " · Stocka")</title>

    @* theme boot — runs before CSS paint, no light/dark flash *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem("stocka-theme"); } catch (e) { }
            if (t !== "light" && t !== "dark") {
                t = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
            }
            var d = document.documentElement;
            d.setAttribute("data-theme", t);
            d.style.colorScheme = t;
        })();
    </script>

    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    @{
        var i18n = new
        {
            required = Stocka.MVC.Localization.Loc.T("Val_Required"),
            email    = Stocka.MVC.Localization.Loc.T("Val_Email"),
            url      = Stocka.MVC.Localization.Loc.T("Val_Url"),
            pattern  = Stocka.MVC.Localization.Loc.T("Val_Pattern"),
            minlength = Stocka.MVC.Localization.Loc.T("Val_MinLength"),
            maxlength = Stocka.MVC.Localization.Loc.T("Val_MaxLength"),
            min      = Stocka.MVC.Localization.Loc.T("Val_Min"),
            max      = Stocka.MVC.Localization.Loc.T("Val_Max"),
            step     = Stocka.MVC.Localization.Loc.T("Val_Step"),
            number   = Stocka.MVC.Localization.Loc.T("Val_Number"),
            oneIssue = Stocka.MVC.Localization.Loc.T("Val_OneIssue"),
            manyIssues = Stocka.MVC.Localization.Loc.T("Val_ManyIssues")
        };
    }
    <script type="application/json" id="stocka-i18n">@Json.Serialize(i18n)</script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
</head>
<body class="bg-bg text-ink">
    @RenderBody()
    @RenderSection("Scripts", required: false)
</body>
</html>
