@model Inventory.Contracts.UseCases.WarehouseCases.UpdateWarehouseCommand
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Warehouses_EditTitle");
    string T(string key) => Loc.T(key);

    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string err = "mt-1.5 block text-[12px] font-medium text-danger";
}

<div class="mx-auto max-w-[42rem]">
    <header class="mb-5 border-b border-line pb-5">
        <h1 class="text-[24px] font-bold tracking-[-.02em]">@T("Warehouses_EditTitle")</h1>
        <p class="mt-1.5 text-[13.5px] text-ink-soft">@T("Warehouses_EditSub")</p>
    </header>

    <form asp-area="Inventory" asp-controller="Warehouses" asp-action="Edit" method="post"
          class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="grid gap-5 p-5 sm:p-7">
            <div asp-validation-summary="ModelOnly" class="rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger empty:hidden"></div>
            <input type="hidden" asp-for="WarehouseId" />

            <div>
                <label class="@label" asp-for="Name">@T("Common_Name")</label>
                <input class="@input" asp-for="Name" maxlength="50" />
                <span asp-validation-for="Name" class="@err"></span>
            </div>

            <div>
                <label class="@label" asp-for="Type">@T("Common_Type")</label>
                <select class="@input" asp-for="Type">
                    <option value="0">@T("Warehouses_Type_Shop")</option>
                    <option value="1">@T("Warehouses_Type_Storage")</option>
                </select>
                <span asp-validation-for="Type" class="@err"></span>
            </div>

            <div>
                <label class="@label" asp-for="Location">@T("Common_Location")</label>
                <input class="@input" asp-for="Location" maxlength="100" />
                <span asp-validation-for="Location" class="@err"></span>
            </div>

            <div>
                <label class="@label" asp-for="Description">@T("Common_Description")</label>
                <textarea class="block min-h-[92px] w-full resize-y rounded-md border border-line bg-surface px-3 py-2.5 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]"
                          asp-for="Description" rows="3" maxlength="600"></textarea>
                <span asp-validation-for="Description" class="@err"></span>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-2.5 border-t border-line bg-sunken/40 px-5 py-4 sm:flex-row sm:justify-end sm:px-7">
            <a class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline"
               asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@Model.WarehouseId">@T("Common_Cancel")</a>
            <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover">
                @T("Common_SaveChanges")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
