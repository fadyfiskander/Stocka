@model IEnumerable<WarehouseDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Warehouses_SearchTitle");
    string T(string key) => Loc.T(key);
}

<div class="container-fluid py-4">
    <h2>@T("Warehouses_SearchHeading")</h2>
    @if (ViewBag.NotFound != null)
    {
        <div class="alert alert-warning">@ViewBag.NotFound</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="get" class="row g-2 mb-4" asp-area="Inventory" asp-controller="Warehouses" asp-action="SearchByName">
        <div class="col-md-6">
            <input type="text" class="form-control" name="name" placeholder="@T("Warehouses_SearchPlaceholder")" value="@Context.Request.Query["name"]" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">@T("Common_Search")</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr><th class="ps-4">@T("Common_Name")</th><th>@T("Common_Location")</th><th>@T("Common_Status")</th><th class="pe-4"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@warehouse.Name</td>
                                <td>@warehouse.Location</td>
                                <td><span class="badge text-bg-@(warehouse.IsActive ? "success" : "secondary")">@(warehouse.IsActive ? T("Common_Active") : T("Common_Inactive"))</span></td>
                                <td class="pe-4 text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@warehouse.Id">@T("Common_Details")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Context.Request.Query["name"]))
    {
        <div class="text-muted">@T("Warehouses_SearchEmpty")</div>
    }
</div>
