@model IEnumerable<WarehouseDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Warehouses_SearchTitle");
    string T(string key) => Loc.T(key);

    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string rowBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-2.5 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
}

<section class="grid gap-5">
    <header class="border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Warehouses_SearchHeading")</h1>
    </header>

    @if (ViewBag.NotFound != null)
    {
        <div class="flex items-start gap-3 rounded-md border border-warn/30 bg-warn-tint px-4 py-3 text-[13px] text-warn">
            <svg class="icon mt-0.5 !size-4 shrink-0"><use href="#i-alert" /></svg><span>@ViewBag.NotFound</span>
        </div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="flex items-start gap-3 rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger">
            <svg class="icon mt-0.5 !size-4 shrink-0"><use href="#i-alert" /></svg><span>@ViewBag.Error</span>
        </div>
    }

    <form method="get" asp-area="Inventory" asp-controller="Warehouses" asp-action="SearchByName"
          class="rounded-lg border border-line bg-surface p-5 shadow-card">
        <div class="flex flex-wrap items-end gap-3">
            <div class="min-w-[220px] flex-1">
                <input type="text" name="name" class="@input" placeholder="@T("Warehouses_SearchPlaceholder")" value="@Context.Request.Query["name"]" />
            </div>
            <button type="submit" class="@btnPrimary">
                <svg class="icon !size-4"><use href="#i-search" /></svg>@T("Common_Search")
            </button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[640px] border-collapse text-[13.5px]">
                    <thead>
                        <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                            <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Name")</th>
                            <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Location")</th>
                            <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Status")</th>
                            <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Common_Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3 font-semibold text-ink">@warehouse.Name</td>
                                <td class="px-4 py-3 text-ink-soft">@warehouse.Location</td>
                                <td class="px-4 py-3">
                                    @if (warehouse.IsActive)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@T("Common_Active")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@T("Common_Inactive")</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end">
                                        <a class="@rowBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@warehouse.Id">@T("Common_Details")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Context.Request.Query["name"]))
    {
        <div class="rounded-lg border border-dashed border-line-strong px-6 py-12 text-center">
            <svg class="icon mx-auto !size-7 text-ink-faint"><use href="#i-search" /></svg>
            <p class="mt-2 text-[13.5px] text-ink-soft">@T("Warehouses_SearchEmpty")</p>
        </div>
    }
</section>
