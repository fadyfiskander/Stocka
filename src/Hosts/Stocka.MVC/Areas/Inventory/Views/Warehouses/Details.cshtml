@model WarehouseDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Warehouses_DetailsTitle");
    string T(string key) => Loc.T(key);
    var inventory = (PaginatedResult<Inventory.Contracts.DTOs.Reports.WarehouseInventoryItemDto>?)ViewBag.Inventory;

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string pageBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageOff = "inline-flex h-8 cursor-not-allowed items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-faint opacity-45";
    const string dt = "text-[11.5px] font-semibold tracking-wide text-ink-faint";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-[22px] font-bold tracking-[-.015em]">@Model.Name</h1>
                @if (Model.IsActive)
                {
                    <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@T("Common_Active")</span>
                }
                else
                {
                    <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@T("Common_Inactive")</span>
                }
            </div>
            <p class="mt-1.5 flex flex-wrap items-center gap-x-2 text-[13.5px] text-ink-soft">
                <span>@Model.Location</span>
                <span class="text-ink-faint">·</span>
                <span>@(Model.Type == 0 ? T("Warehouses_Type_Shop") : T("Warehouses_Type_Storage"))</span>
                <span class="text-ink-faint">·</span>
                <span>@Loc.F("Warehouses_DetailsSub", ViewBag.TotalUnits)</span>
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a class="@btnGhost" asp-area="Inventory" asp-controller="Stock" asp-action="Movements" asp-route-warehouseId="@Model.Id">
                <svg class="icon !size-4"><use href="#i-swap" /></svg>@T("Warehouses_Movements")
            </a>
            <a class="@btnGhost" asp-area="Inventory" asp-controller="Warehouses" asp-action="Edit" asp-route-id="@Model.Id">
                <svg class="icon !size-4"><use href="#i-pencil" /></svg>@T("Common_Edit")
            </a>
            <a class="@btnPrimary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">
                <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Common_BackToList")
            </a>
        </div>
    </header>

    <div class="rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <svg class="icon !size-[18px] text-accent"><use href="#i-store" /></svg>
            <span class="text-[14px] font-semibold text-ink">@T("Warehouses_DetailsTitle")</span>
        </div>
        <dl class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2 lg:grid-cols-3">
            <div class="min-w-0">
                <dt class="@dt">@T("Common_Name")</dt>
                <dd class="mt-1 text-[14px] font-semibold text-ink">@Model.Name</dd>
            </div>
            <div class="min-w-0">
                <dt class="@dt">@T("Common_Location")</dt>
                <dd class="mt-1 text-[14px] font-semibold text-ink">@Model.Location</dd>
            </div>
            <div class="min-w-0 sm:col-span-2 lg:col-span-1">
                <dt class="@dt">@T("Common_Description")</dt>
                <dd class="mt-1 text-[13.5px] text-ink-soft">@Model.Description</dd>
            </div>
            <div class="min-w-0">
                <dt class="@dt">@T("Common_Organization")</dt>
                <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.OrganizationId</dd>
            </div>
            <div class="min-w-0">
                <dt class="@dt">@T("Warehouses_WarehouseId")</dt>
                <dd class="num mt-1 break-all font-mono text-[12.5px] text-ink-soft">@Model.Id</dd>
            </div>
        </dl>
    </div>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <span class="flex items-center gap-2.5 text-[14px] font-semibold text-ink">
                <svg class="icon !size-[18px] text-accent"><use href="#i-layers" /></svg>
                @T("Warehouses_InventoryTitle")
            </span>
            @if (inventory != null)
            {
                <span class="num rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@inventory.TotalCount</span>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Product")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Batch")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Common_Quantity")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Warehouses_BatchUnitCost")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Warehouses_LineCost")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (inventory != null && inventory.Items.Any())
                    {
                        @foreach (var item in inventory.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@item.ProductId</span></td>
                                <td class="px-4 py-3">
                                    <a class="num break-all font-mono text-[12px] font-medium" asp-area="Inventory" asp-controller="Batches" asp-action="Details" asp-route-id="@item.BatchId">@item.BatchId</a>
                                </td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@item.Quantity</td>
                                <td class="num px-4 py-3 text-end text-ink-soft">@item.BatchUnitCost.ToString("N2")</td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@item.LineCost.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <svg class="icon mx-auto !size-7 text-ink-faint"><use href="#i-layers" /></svg>
                                <p class="mt-2 text-[13.5px] text-ink-soft">@T("Warehouses_InventoryEmpty")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (inventory != null)
    {
        <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="text-[12.5px] text-ink-faint">@Loc.F("Common_PageOf", inventory.Page, inventory.TotalPages) @Loc.F("Warehouses_Placements", inventory.TotalCount)</span>
            <div class="flex items-center gap-1.5">
                @if (inventory.HasPrevious)
                {
                    <a class="@pageBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@Model.Id" asp-route-inventoryPage="@(inventory.Page - 1)">
                        <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Common_Previous")
                    </a>
                }
                else
                {
                    <span class="@pageOff"><svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Common_Previous")</span>
                }
                @if (inventory.HasNext)
                {
                    <a class="@pageBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@Model.Id" asp-route-inventoryPage="@(inventory.Page + 1)">
                        @T("Common_Next")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg>
                    </a>
                }
                else
                {
                    <span class="@pageOff">@T("Common_Next")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg></span>
                }
            </div>
        </div>
    }
</section>
