@model PaginatedResult<WarehouseDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = (Loc.IsEn ? "Warehouses" : "المستودعات");
    var isActive = Context.Request.Query["isActive"].ToString();
    bool? activeFilter = isActive switch { "true" => true, "false" => false, _ => (bool?)null };

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string rowBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-2.5 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageOff = "inline-flex h-8 cursor-not-allowed items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-faint opacity-45";
    string seg(bool selected) => selected
        ? "inline-flex h-8 items-center rounded-full bg-accent-tint px-3.5 text-[12.5px] font-semibold text-accent"
        : "inline-flex h-8 items-center rounded-full px-3.5 text-[12.5px] font-medium text-ink-soft transition-colors hover:bg-sunken hover:text-ink";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
            <h1 class="font-bold tracking-[-.015em] text-[22px]">@(Loc.IsEn ? "Warehouses" : "المستودعات")</h1>
            <p class="mt-1.5 text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Storage locations of the current organization." : "مواقع التخزين الخاصة بالمؤسسة الحالية.")</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a class="@btnGhost" asp-area="Inventory" asp-controller="Warehouses" asp-action="SearchByName">
                <svg class="icon !size-4"><use href="#i-search" /></svg>@(Loc.IsEn ? "Search by name" : "بحث بالاسم")
            </a>
            <a class="@btnPrimary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Create">
                <svg class="icon !size-4"><use href="#i-plus" /></svg>@(Loc.IsEn ? "Register warehouse" : "تسجيل مستودع")
            </a>
        </div>
    </header>

    <div class="shadow-card inline-flex w-fit items-center gap-1 rounded-full border border-line bg-surface p-1">
        <a class="@seg(activeFilter is null)" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">@(Loc.IsEn ? $"All ({Model.TotalCount})" : $"الكل ({Model.TotalCount})")</a>
        <a class="@seg(activeFilter == true)" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="true">@(Loc.IsEn ? "Active" : "نشط")</a>
        <a class="@seg(activeFilter == false)" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="false">@(Loc.IsEn ? "Inactive" : "غير نشط")</a>
    </div>

    <div class="shadow-card overflow-hidden rounded-lg border border-line bg-surface">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start font-semibold text-[11.5px]">@(Loc.IsEn ? "Name" : "الاسم")</th>
                        <th class="px-4 py-2.5 text-start font-semibold text-[11.5px]">@(Loc.IsEn ? "Location" : "الموقع")</th>
                        <th class="px-4 py-2.5 text-start font-semibold text-[11.5px]">@(Loc.IsEn ? "Type" : "النوع")</th>
                        <th class="px-4 py-2.5 text-start font-semibold text-[11.5px]">@(Loc.IsEn ? "Status" : "الحالة")</th>
                        <th class="px-4 py-2.5 text-end font-semibold text-[11.5px]">@(Loc.IsEn ? "Actions" : "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var warehouse in Model.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-ink">@warehouse.Name</div>
                                </td>
                                <td class="px-4 py-3 text-ink-soft">@warehouse.Location</td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-sunken px-2.5 py-0.5 font-semibold text-[11.5px] text-ink-soft">
                                        @(warehouse.Type == 0 ? (Loc.IsEn ? "Shop" : "متجر") : (Loc.IsEn ? "Storage" : "مخزن"))
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    @if (warehouse.IsActive)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 font-semibold text-[11.5px] text-ok">@(Loc.IsEn ? "Active" : "نشط")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 font-semibold text-[11.5px] text-ink-soft">@(Loc.IsEn ? "Inactive" : "غير نشط")</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-end gap-1.5">
                                        <a class="@rowBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@warehouse.Id">@(Loc.IsEn ? "Details" : "التفاصيل")</a>
                                        <a class="@rowBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Edit" asp-route-id="@warehouse.Id">@(Loc.IsEn ? "Edit" : "تعديل")</a>
                                        @if (warehouse.IsActive)
                                        {
                                            <form asp-area="Inventory" asp-controller="Warehouses" asp-action="Deactivate" asp-route-id="@warehouse.Id" method="post" class="inline-flex">
                                                <button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-warn/35 bg-transparent px-2.5 font-medium text-[12.5px] text-warn transition-colors hover:bg-warn-tint">@(Loc.IsEn ? "Deactivate" : "إيقاف")</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Inventory" asp-controller="Warehouses" asp-action="Activate" asp-route-id="@warehouse.Id" method="post" class="inline-flex">
                                                <button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-ok/35 bg-transparent px-2.5 font-medium text-[12.5px] text-ok transition-colors hover:bg-ok-tint">@(Loc.IsEn ? "Activate" : "تفعيل")</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-14 text-center">
                                <svg class="icon mx-auto !size-8 text-ink-faint"><use href="#i-store" /></svg>
                                <p class="mt-2 font-semibold text-[14px] text-ink">@(Loc.IsEn ? "No warehouses found." : "لا توجد مستودعات.")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-[12.5px] text-ink-faint">@(Loc.IsEn ? $"Page {Model.Page} of {Model.TotalPages}" : $"صفحة {Model.Page} من {Model.TotalPages}") · <span class="num">@Model.TotalCount</span></span>
        <div class="flex items-center gap-1.5">
            @if (Model.HasPrevious)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="@isActive" asp-route-page="@(Model.Page - 1)">
                    <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@(Loc.IsEn ? "Previous" : "السابق")
                </a>
            }
            else
            {
                <span class="@pageOff"><svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@(Loc.IsEn ? "Previous" : "السابق")</span>
            }

            @if (Model.HasNext)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="@isActive" asp-route-page="@(Model.Page + 1)">
                    @(Loc.IsEn ? "Next" : "التالي")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg>
                </a>
            }
            else
            {
                <span class="@pageOff">@(Loc.IsEn ? "Next" : "التالي")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg></span>
            }
        </div>
    </div>
</section>
