@model PaginatedResult<WarehouseDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Warehouses_Title");
    string T(string key) => Loc.T(key);
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="mb-1">@T("Warehouses_Title")</h2>
            <p class="text-muted mb-0">@T("Warehouses_Sub")</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-area="Inventory" asp-controller="Warehouses" asp-action="SearchByName">@T("Products_SearchByName")</a>
            <a class="btn btn-primary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Create">@T("Warehouses_Register")</a>
        </div>
    </div>

    <div class="btn-group mb-3" role="group">
        <a class="btn btn-sm btn-outline-secondary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">@Loc.F("Warehouses_All", Model.TotalCount)</a>
        <a class="btn btn-sm btn-outline-success" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="true">@T("Common_Active")</a>
        <a class="btn btn-sm btn-outline-secondary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-isActive="false">@T("Common_Inactive")</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@T("Common_Name")</th>
                            <th>@T("Common_Location")</th>
                            <th>@T("Common_Type")</th>
                            <th>@T("Common_Status")</th>
                            <th class="pe-4 text-end">@T("Common_Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var warehouse in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@warehouse.Name</div>
                                        <small class="text-muted">@warehouse.Id</small>
                                    </td>
                                    <td>@warehouse.Location</td>
                                    <td>@(warehouse.Type == 0 ? T("Warehouses_Type_Shop") : T("Warehouses_Type_Storage"))</td>
                                    <td>
                                        @if (warehouse.IsActive)
                                        {
                                            <span class="badge text-bg-success">@T("Common_Active")</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@T("Common_Inactive")</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-sm btn-outline-primary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@warehouse.Id">@T("Common_Details")</a>
                                            <a class="btn btn-sm btn-outline-secondary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Edit" asp-route-id="@warehouse.Id">@T("Common_Edit")</a>
                                            @if (warehouse.IsActive)
                                            {
                                                <form asp-area="Inventory" asp-controller="Warehouses" asp-action="Deactivate" asp-route-id="@warehouse.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">@T("Common_Deactivate")</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Inventory" asp-controller="Warehouses" asp-action="Activate" asp-route-id="@warehouse.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">@T("Common_Activate")</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="py-5 text-center text-muted">@T("Warehouses_Empty")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">@Loc.F("Common_PageOf", Model.Page, Model.TotalPages) (@Model.TotalCount)</small>
        <div class="btn-group">
            <a asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-page="@(Model.Page - 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")">@T("Common_Previous")</a>
            <a asp-area="Inventory" asp-controller="Warehouses" asp-action="Index" asp-route-page="@(Model.Page + 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")">@T("Common_Next")</a>
        </div>
    </div>
</div>
