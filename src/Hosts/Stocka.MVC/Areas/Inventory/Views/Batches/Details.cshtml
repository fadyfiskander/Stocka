@model Inventory.Contracts.DTOs.Batch.BatchDetailsDto
@using Inventory.Contracts.DTOs.StockMovement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Batches_DetailsTitle");

    // Translate with a built-in fallback when a key is missing (Loc returns the key itself)
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string key, string? ar = null, string? en = null)
    {
        var v = Loc.T(key);
        if (en != null && v == key) return isAr ? (ar ?? en) : en;
        return v;
    }

    // 0 PurchaseIn, 1 SaleOut, 2 TransferIn, 3 TransferOut, 4 AdjustmentIn, 5 AdjustmentOut, 6 OrderReturn
    string MoveType(int t) => Loc.T(t switch
    {
        0 => "Move_PurchaseIn",
        1 => "Move_SaleOut",
        2 => "Move_TransferIn",
        3 => "Move_TransferOut",
        4 => "Move_AdjustmentIn",
        5 => "Move_AdjustmentOut",
        6 => "Move_OrderReturn",
        _ => "Move_PurchaseIn"
    });
    bool IsIncoming(int t) => t == 0 || t == 2 || t == 4 || t == 6;

    var movements = ((IEnumerable<StockMovementDto>?)ViewBag.Movements)?.ToList() ?? new List<StockMovementDto>();
    var warehouses = (PaginatedResult<WarehouseDto>?)ViewBag.ActiveWarehouses;
    var whItems = warehouses?.Items?.ToList() ?? new List<WarehouseDto>();

    var whPlain = whItems.Select(w => new SelectListItem(w.Name, w.Id.ToString())).ToList();
    var whWithLocation = whItems.Select(w => new SelectListItem(
        string.IsNullOrWhiteSpace(w.Location) ? w.Name : $"{w.Name} ({w.Location})", w.Id.ToString())).ToList();

    var whNames = whItems.GroupBy(w => w.Id.ToString()).ToDictionary(g => g.Key, g => g.First().Name);
    string WarehouseLabel(object id)
    {
        var key = id?.ToString() ?? "-";
        if (whNames.TryGetValue(key, out var name)) return name;
        return key.Length > 8 ? key.Substring(0, 8) : key;
    }

    double initial = Convert.ToDouble(Model.InitialQuantity);
    double Pct(object v) => initial <= 0 ? 0 : Math.Min(100, Math.Max(0, Convert.ToDouble(v) / initial * 100));
    string W(double p) => Math.Round(p, 1).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

    string selectText = T("Common_Select", "اختر…", "Select…");

    // ───── shared Tailwind class sets (literal tokens so the scanner sees them) ─────
    const string card = "min-w-0 overflow-hidden rounded-lg border border-line bg-surface shadow-card";
    const string cardHead = "flex items-center justify-between gap-3 border-b border-line px-4 py-3 text-[13.5px] font-semibold text-ink";
    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string select = input;
    const string btn = "inline-flex h-9 items-center justify-center gap-2 rounded-md border border-transparent px-4 text-[13.5px] font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-50";
    const string tab = "inline-flex items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-[13px] font-medium text-ink-soft transition-colors hover:bg-sunken hover:text-ink aria-selected:border-line aria-selected:bg-sunken aria-selected:font-semibold aria-selected:text-ink";
    const string actionsBetween = "col-span-12 flex flex-wrap items-center justify-between gap-3";
    const string actionsEnd = "col-span-12 flex justify-end";
    const string note = "text-[11.5px] text-ink-faint";
    const string formGrid = "grid grid-cols-12 gap-4";
}

<div id="bd-page" class="mx-auto w-full max-w-[1400px]">

    @* ───────── Header ───────── *@
    <header class="mb-5 flex flex-wrap items-start justify-between gap-4 border-b border-line pb-5">
        <div class="min-w-0">
            <h1 class="flex flex-wrap items-center gap-3 text-[22px] font-bold tracking-[-.015em]">
                @T("Batches_DetailsTitle")
                @if (Model.IsExhausted)
                {
                    <span class="inline-flex items-center rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@T("Batches_FullyAllocated")</span>
                }
            </h1>
            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[12.5px] text-ink-faint">
                <span>@T("Common_Product"): <code class="num break-all font-mono text-ink-soft">@Model.ProductId</code></span>
                <span>@T("Batches_PurchaseItemId"): <code class="num break-all font-mono text-ink-soft">@Model.PurchaseItemId</code></span>
            </div>
        </div>
        <a asp-area="Inventory" asp-controller="Batches" asp-action="Index"
           class="inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline">
            <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@T("Batches_BackToList")
        </a>
    </header>

    <div class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">

        @* ───────── Main: operations + history ───────── *@
        <div class="grid min-w-0 gap-5">

            <section class="@card">
                <div class="@cardHead">@T("Batches_Actions", "العمليات", "Operations")</div>

                <div class="flex flex-wrap gap-1.5 border-b border-line px-4 py-3" role="tablist">
                    <button type="button" role="tab" aria-selected="true" data-pane="pane-allocate" class="@tab"><span class="size-2 rounded-full bg-accent"></span>@T("Batches_AllocateTitle")</button>
                    <button type="button" role="tab" aria-selected="false" data-pane="pane-transfer" class="@tab"><span class="size-2 rounded-full bg-info"></span>@T("Batches_TransferTitle")</button>
                    <button type="button" role="tab" aria-selected="false" data-pane="pane-sale" class="@tab"><span class="size-2 rounded-full bg-signal"></span>@T("Batches_SaleTitle")</button>
                    <button type="button" role="tab" aria-selected="false" data-pane="pane-return" class="@tab"><span class="size-2 rounded-full bg-ok"></span>@T("Batches_ReturnTitle")</button>
                    <button type="button" role="tab" aria-selected="false" data-pane="pane-adjust" class="@tab"><span class="size-2 rounded-full bg-ink-faint"></span>@T("Batches_AdjustTitle")</button>
                    <button type="button" role="tab" aria-selected="false" data-pane="pane-damage" class="@tab"><span class="size-2 rounded-full bg-danger"></span>@T("Batches_DamageTitle")</button>
                </div>

                <div class="p-4">

                    @* Allocate *@
                    <div data-bd-pane id="pane-allocate" role="tabpanel">
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Allocate" method="post" class="js-once @formGrid">
                            <div asp-validation-summary="ModelOnly" class="col-span-12 text-[12.5px] text-danger empty:hidden"></div>
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <fieldset disabled="@(Model.RemainingQuantity <= 0)" class="col-span-12 m-0 grid min-w-0 grid-cols-12 gap-4 border-0 p-0 disabled:opacity-50">
                                <div class="col-span-12 sm:col-span-8">
                                    <label class="@label">@T("Common_Warehouse")</label>
                                    <select name="WarehouseId" class="@select" asp-items="whWithLocation" required>
                                        <option value="">@selectText</option>
                                    </select>
                                </div>
                                <div class="col-span-12 sm:col-span-4">
                                    <label class="@label">@T("Common_Quantity")</label>
                                    <input type="number" name="Quantity" class="@input num" min="1" max="@Model.RemainingQuantity" required />
                                </div>
                                <div class="@actionsBetween">
                                    <small class="@note">@Loc.F("Batches_AllocateNote", Model.RemainingQuantity)</small>
                                    <button type="submit" class="@btn bg-accent text-on-accent hover:bg-accent-hover">@T("Batches_Allocate")</button>
                                </div>
                            </fieldset>
                        </form>
                    </div>

                    @* Transfer *@
                    <div data-bd-pane id="pane-transfer" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Transfer" method="post" id="transferForm" class="js-once @formGrid">
                            <div asp-validation-summary="ModelOnly" class="col-span-12 text-[12.5px] text-danger empty:hidden"></div>
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="col-span-12 sm:col-span-6">
                                <label class="@label">@T("Batches_Source")</label>
                                <select name="SourceWarehouseId" class="@select" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="col-span-12 sm:col-span-6">
                                <label class="@label">@T("Batches_Destination")</label>
                                <select name="DestinationWarehouseId" class="@select" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="col-span-12 sm:col-span-4">
                                <label class="@label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="@input num" min="1" required />
                            </div>
                            <div class="col-span-12 sm:col-span-8">
                                <label class="@label">@T("Batches_ReasonOptional")</label>
                                <input type="text" name="Reason" class="@input" maxlength="300" />
                            </div>
                            <div class="@actionsBetween">
                                <small class="@note">@T("Batches_TransferNote")</small>
                                <button type="submit" class="@btn border-info/25 bg-info-tint text-info hover:bg-info/15">@T("Batches_Transfer", "تحويل", "Transfer")</button>
                            </div>
                        </form>
                    </div>

                    @* Sale *@
                    <div data-bd-pane id="pane-sale" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Sale" method="post" class="js-once @formGrid">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="col-span-12 sm:col-span-4">
                                <label class="@label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="@input num" min="1" required />
                            </div>
                            <div class="col-span-12 sm:col-span-8">
                                <label class="@label">@T("Batches_OrderRef")</label>
                                <input type="text" name="OrderReferenceId" class="@input" />
                            </div>
                            <div class="col-span-12">
                                <label class="@label">@T("Common_Reason")</label>
                                <input type="text" name="Reason" class="@input" maxlength="300" />
                            </div>
                            <div class="@actionsEnd">
                                <button type="submit" class="@btn border-signal/25 bg-signal-tint text-signal hover:bg-signal/15">@T("Batches_SaleOut")</button>
                            </div>
                        </form>
                    </div>

                    @* Return *@
                    <div data-bd-pane id="pane-return" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Return" method="post" class="js-once @formGrid">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="col-span-12 sm:col-span-4">
                                <label class="@label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="@input num" min="1" required />
                            </div>
                            <div class="col-span-12 sm:col-span-8">
                                <label class="@label">@T("Batches_OriginalOrder")</label>
                                <input type="text" name="OrderReferenceId" class="@input" />
                            </div>
                            <div class="col-span-12">
                                <label class="@label">@T("Common_Reason")</label>
                                <input type="text" name="Reason" class="@input" maxlength="300" />
                            </div>
                            <div class="@actionsEnd">
                                <button type="submit" class="@btn border-ok/25 bg-ok-tint text-ok hover:bg-ok/15">@T("Batches_ReturnIn")</button>
                            </div>
                        </form>
                    </div>

                    @* Adjust *@
                    <div data-bd-pane id="pane-adjust" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Adjust" method="post" class="js-once @formGrid">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="col-span-12 sm:col-span-8">
                                <label class="@label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="@select" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="col-span-12 sm:col-span-4">
                                <label class="@label">@T("Batches_Counted")</label>
                                <input type="number" name="CountedQuantity" class="@input num" min="0" required />
                            </div>
                            <div class="col-span-12">
                                <label class="@label">@T("Batches_AdjustReason")</label>
                                <input type="text" name="Reason" class="@input" maxlength="300" required />
                            </div>
                            <div class="@actionsEnd">
                                <button type="submit" class="@btn border-line bg-sunken text-ink-soft hover:bg-line hover:text-ink">@T("Batches_Adjust", "حفظ الجرد", "Save count")</button>
                            </div>
                        </form>
                    </div>

                    @* Damage *@
                    <div data-bd-pane id="pane-damage" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Damage" method="post" class="js-once @formGrid">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="col-span-12 sm:col-span-6">
                                <label class="@label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="@select" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="col-span-12 sm:col-span-3">
                                <label class="@label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="@input num" min="1" required />
                            </div>
                            <div class="col-span-12 sm:col-span-3">
                                <label class="@label">@T("Batches_Ref")</label>
                                <input type="text" name="ReferenceId" class="@input" />
                            </div>
                            <div class="col-span-12">
                                <label class="@label">@T("Batches_DamageReason")</label>
                                <input type="text" name="Reason" class="@input" maxlength="300" required />
                            </div>
                            <div class="@actionsEnd">
                                <button type="submit" class="@btn border-danger/25 bg-danger-tint text-danger hover:bg-danger/15">@T("Batches_WriteOff")</button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            @* ───────── Movement history ───────── *@
            <section class="@card">
                <div class="@cardHead">
                    <span>@T("Batches_MovementHistory")</span>
                    <span class="num rounded-full bg-sunken px-2.5 py-0.5 text-[11.5px] font-semibold text-ink-soft">@movements.Count</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[860px] border-collapse text-[13.5px]">
                        <thead>
                            <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Date")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Type")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Quantity")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Warehouse")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Reference")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Reason")</th>
                                <th class="whitespace-nowrap px-3.5 py-2.5 text-start text-[11.5px] font-semibold">@T("Batches_Col_Correct")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (movements.Count > 0)
                            {
                                foreach (var m in movements)
                                {
                                    var incoming = IsIncoming(m.MovementType);
                                    var transferLeg = m.MovementType == 2 || m.MovementType == 3;
                                    <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                        <td class="whitespace-nowrap px-3.5 py-3"><span class="num font-mono text-[12.5px] text-ink-soft" dir="ltr">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                                        <td class="whitespace-nowrap px-3.5 py-3">
                                            @if (incoming)
                                            {
                                                <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@MoveType(m.MovementType)</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-danger-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-danger">@MoveType(m.MovementType)</span>
                                            }
                                        </td>
                                        <td class="whitespace-nowrap px-3.5 py-3">
                                            @if (incoming)
                                            {
                                                <span class="num font-bold text-ok" dir="ltr">+@m.Quantity</span>
                                            }
                                            else
                                            {
                                                <span class="num font-bold text-danger" dir="ltr">-@m.Quantity</span>
                                            }
                                        </td>
                                        <td class="whitespace-nowrap px-3.5 py-3 text-ink-soft">@WarehouseLabel(m.WarehouseId)</td>
                                        <td class="whitespace-nowrap px-3.5 py-3 text-ink-faint">@(m.ReferenceId?.ToString() ?? "-")</td>
                                        <td class="max-w-72 min-w-36 px-3.5 py-3 text-ink-soft">@(string.IsNullOrWhiteSpace(m.Reason) ? "-" : m.Reason)</td>
                                        <td class="whitespace-nowrap px-3.5 py-3">
                                            @if (!transferLeg)
                                            {
                                                <button type="button"
                                                        data-reverse-url="@Url.Action("ReverseMovement", "Stock", new { area = "Inventory", id = m.Id })"
                                                        data-summary="@MoveType(m.MovementType) (@m.Quantity)"
                                                        title="@T("Batches_ReverseTitle")"
                                                        class="inline-flex h-8 items-center rounded-md border border-danger/35 bg-transparent px-2.5 text-[12px] font-medium text-danger transition-colors hover:bg-danger-tint">
                                                    @T("Batches_Reverse")
                                                </button>
                                            }
                                            else
                                            {
                                                <small class="@note">@T("Batches_CounterTransfer")</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="px-4 py-12 text-center text-[13.5px] text-ink-soft">@T("Batches_NoMovements")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        @* ───────── Side: quantities + cost (first on small screens) ───────── *@
        <aside class="order-first grid min-w-0 gap-5 xl:order-none">

            <section class="@card">
                <div class="@cardHead">@T("Batches_QuantitiesTitle")</div>
                <div class="p-4">
                    <div class="mb-4 grid grid-cols-2 gap-x-4 gap-y-4">
                        <div>
                            <div class="text-[11.5px] text-ink-faint">@T("Batches_InitialReceived")</div>
                            <div class="text-[24px] font-bold leading-tight tracking-[-.02em] text-ink"><span class="num" dir="ltr">@Model.InitialQuantity</span></div>
                        </div>
                        <div>
                            <div class="text-[11.5px] text-ink-faint">@T("Batches_UnallocatedRemaining")</div>
                            <div class="text-[24px] font-bold leading-tight tracking-[-.02em] text-signal"><span class="num" dir="ltr">@Model.RemainingQuantity</span></div>
                        </div>
                        <div>
                            <div class="text-[11.5px] text-ink-faint">@T("Batches_InWarehouses")</div>
                            <div class="text-[24px] font-bold leading-tight tracking-[-.02em] text-ok"><span class="num" dir="ltr">@Model.QuantityInWarehouses</span></div>
                        </div>
                        <div>
                            <div class="text-[11.5px] text-ink-faint">@T("Batches_EverAllocated")</div>
                            <div class="text-[24px] font-bold leading-tight tracking-[-.02em] text-ink"><span class="num" dir="ltr">@Model.AllocatedQuantity</span></div>
                        </div>
                    </div>

                    <div class="flex h-2 overflow-hidden rounded-full bg-sunken" role="img"
                         aria-label="@T("Batches_UnallocatedRemaining") / @T("Batches_InWarehouses")">
                        <span class="block h-full bg-signal" style="width:@W(Pct(Model.RemainingQuantity))"></span>
                        <span class="block h-full bg-ok" style="width:@W(Pct(Model.QuantityInWarehouses))"></span>
                    </div>
                    <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1 text-[11.5px] text-ink-faint">
                        <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-signal"></i>@T("Batches_UnallocatedRemaining")</span>
                        <span class="inline-flex items-center gap-1.5"><i class="size-2 rounded-full bg-ok"></i>@T("Batches_InWarehouses")</span>
                    </div>
                </div>
            </section>

            <section class="@card">
                <div class="@cardHead">@T("Batches_CostTitle")</div>
                <div class="p-4">
                    <dl class="text-[13.5px]">
                        <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
                            <dt class="text-ink-soft">@T("Batches_UnitCost")</dt>
                            <dd class="num font-semibold text-ink" dir="ltr">@Model.UnitCost.ToString("N2")</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
                            <dt class="text-ink-soft">@T("Batches_InitialTotalCost")</dt>
                            <dd class="num font-semibold text-ink" dir="ltr">@Model.InitialTotalCost.ToString("N2")</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
                            <dt class="text-ink-soft">@T("Batches_RemainingValue")</dt>
                            <dd class="num font-semibold text-ink" dir="ltr">@Model.RemainingValue.ToString("N2")</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-4 py-2.5">
                            <dt class="text-ink-soft">@T("Batches_ReceivedAt")</dt>
                            <dd class="num font-semibold text-ink" dir="ltr">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                        </div>
                    </dl>
                    <small class="@note mt-3 block">@T("Batches_CostNote")</small>
                </div>
            </section>
        </aside>
    </div>

    @* One shared dialog for reversing any movement *@
    <dialog id="bdReverseDialog" aria-labelledby="bdReverseTitle"
            class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-line bg-surface p-0 text-ink shadow-pop backdrop:bg-black/50">
        <form method="post" id="bdReverseForm" class="js-once" asp-antiforgery="false">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.Id" />
            <div id="bdReverseTitle" class="border-b border-line px-5 py-4 text-[14px] font-semibold">@T("Batches_ReverseTitle")</div>
            <div class="grid gap-3.5 p-5">
                <div id="bdReverseSummary" class="font-semibold"></div>
                <div>
                    <label for="bdReverseReason" class="@label">@T("Batches_CorrectionReason")</label>
                    <input type="text" id="bdReverseReason" name="reason" class="@input" required maxlength="290" />
                </div>
            </div>
            <div class="flex justify-end gap-2.5 border-t border-line px-5 py-4">
                <button type="button" id="bdReverseCancel"
                        class="@btn border-line bg-surface font-medium text-ink hover:bg-sunken">
                    @T("Common_Cancel", "إلغاء", "Cancel")
                </button>
                <button type="submit" class="@btn border-danger/25 bg-danger-tint text-danger hover:bg-danger/15">@T("Batches_Reverse")</button>
            </div>
        </form>
    </dialog>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var page = document.getElementById('bd-page');
        if (!page) return;

        // 1) Operation tabs (remembers the last one, so a failed submit lands on the same form)
        var key = 'batch-details-tab';
        var tabs = Array.prototype.slice.call(page.querySelectorAll('[data-pane]'));
        var panes = Array.prototype.slice.call(page.querySelectorAll('[data-bd-pane]'));
        function show(id, remember) {
            tabs.forEach(function (t) { t.setAttribute('aria-selected', t.getAttribute('data-pane') === id ? 'true' : 'false'); });
            panes.forEach(function (p) { p.hidden = p.id !== id; });
            if (remember) { try { sessionStorage.setItem(key, id); } catch (e) { } }
        }
        tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-pane'), true); }); });
        try {
            var saved = sessionStorage.getItem(key);
            if (saved && document.getElementById(saved)) show(saved, false);
        } catch (e) { }

        // 2) Reverse dialog
        var dlg = document.getElementById('bdReverseDialog');
        var rform = document.getElementById('bdReverseForm');
        var rreason = document.getElementById('bdReverseReason');
        var rsummary = document.getElementById('bdReverseSummary');
        page.querySelectorAll('[data-reverse-url]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                rform.action = btn.getAttribute('data-reverse-url');
                rsummary.textContent = btn.getAttribute('data-summary') || '';
                rreason.value = '';
                if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
                rreason.focus();
            });
        });
        document.getElementById('bdReverseCancel').addEventListener('click', function () { dlg.close(); });
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });

        // 3) Transfer: source and destination can't be the same warehouse
        var tf = document.getElementById('transferForm');
        if (tf) {
            var src = tf.querySelector('[name="SourceWarehouseId"]');
            var dst = tf.querySelector('[name="DestinationWarehouseId"]');
            var sync = function () {
                Array.prototype.forEach.call(dst.options, function (o) { o.disabled = o.value !== '' && o.value === src.value; });
                if (dst.value === src.value) dst.value = '';
            };
            src.addEventListener('change', sync);
            sync();
        }

        // 4) Prevent double submits (a double click would post the stock movement twice)
        page.querySelectorAll('form.js-once').forEach(function (f) {
            f.addEventListener('submit', function () {
                if (!f.checkValidity()) return;
                setTimeout(function () {
                    f.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
                }, 0);
            });
        });

        // 5) Dismissible alerts
        page.querySelectorAll('[data-dismiss-alert]').forEach(function (b) {
            b.addEventListener('click', function () { b.parentElement.remove(); });
        });
    });
</script>
