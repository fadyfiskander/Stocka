@model Inventory.Contracts.DTOs.Batch.BatchDetailsDto
@using Inventory.Contracts.DTOs.StockMovement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Batches_DetailsTitle");
    string T(string key) => Loc.T(key);
    string MoveType(int t) => Loc.T(t switch
    {
        0 => "Move_PurchaseIn",
        1 => "Move_SaleOut",
        2 => "Move_TransferIn",
        3 => "Move_TransferOut",
        4 => "Move_AdjustmentIn",
        5 => "Move_AdjustmentOut",
        6 => "Move_OrderReturn",
        _ => "Move_PurchaseIn"
    });
    var movements = (IEnumerable<StockMovementDto>?)ViewBag.Movements;
    var warehouses = (PaginatedResult<WarehouseDto>?)ViewBag.ActiveWarehouses;
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@T("Batches_DetailsTitle")</h2>
            <p class="text-muted mb-0">
                @T("Common_Product") @Model.ProductId &middot; @T("Batches_PurchaseItemId") @Model.PurchaseItemId
                @(Model.IsExhausted ? T("Batches_FullyAllocated") : string.Empty)
            </p>
        </div>
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Batches" asp-action="Index">@T("Batches_BackToList")</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_QuantitiesTitle")</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">@T("Batches_InitialReceived")</dt><dd class="col-sm-6">@Model.InitialQuantity</dd>
                        <dt class="col-sm-6">@T("Batches_UnallocatedRemaining")</dt><dd class="col-sm-6">@Model.RemainingQuantity</dd>
                        <dt class="col-sm-6">@T("Batches_EverAllocated")</dt><dd class="col-sm-6">@Model.AllocatedQuantity</dd>
                        <dt class="col-sm-6">@T("Batches_InWarehouses")</dt><dd class="col-sm-6">@Model.QuantityInWarehouses</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_CostTitle")</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">@T("Batches_UnitCost")</dt><dd class="col-sm-6">@Model.UnitCost.ToString("N2")</dd>
                        <dt class="col-sm-6">@T("Batches_InitialTotalCost")</dt><dd class="col-sm-6">@Model.InitialTotalCost.ToString("N2")</dd>
                        <dt class="col-sm-6">@T("Batches_RemainingValue")</dt><dd class="col-sm-6">@Model.RemainingValue.ToString("N2")</dd>
                        <dt class="col-sm-6">@T("Batches_ReceivedAt")</dt><dd class="col-sm-6">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                    <small class="text-muted">@T("Batches_CostNote")</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_AllocateTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Allocate" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-7">
                                <label class="form-label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name (@w.Location)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="form-control" min="1" max="@Model.RemainingQuantity" required />
                            </div>
                            <div class="col-sm-2"><button type="submit" class="btn btn-primary w-100">@T("Batches_Allocate")</button></div>
                        </div>
                        <small class="text-muted">@Loc.F("Batches_AllocateNote", Model.RemainingQuantity)</small>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_TransferTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Transfer" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-5">
                                <label class="form-label">@T("Batches_Source")</label>
                                <select name="SourceWarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label">@T("Batches_Destination")</label>
                                <select name="DestinationWarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-2">
                                <label class="form-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="form-control" min="1" required />
                            </div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="@T("Batches_ReasonOptional")" maxlength="300" /></div>
                        <small class="text-muted">@T("Batches_TransferNote")</small>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_SaleTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Sale" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4"><input type="number" name="Quantity" class="form-control" min="1" placeholder="@T("Common_Quantity")" required /></div>
                            <div class="col-sm-5"><input type="text" name="OrderReferenceId" class="form-control" placeholder="@T("Batches_OrderRef")" /></div>
                            <div class="col-sm-3"><button type="submit" class="btn btn-warning w-100">@T("Batches_SaleOut")</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="@T("Common_Reason")" maxlength="300" /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_ReturnTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Return" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4"><input type="number" name="Quantity" class="form-control" min="1" placeholder="@T("Common_Quantity")" required /></div>
                            <div class="col-sm-5"><input type="text" name="OrderReferenceId" class="form-control" placeholder="@T("Batches_OriginalOrder")" /></div>
                            <div class="col-sm-3"><button type="submit" class="btn btn-success w-100">@T("Batches_ReturnIn")</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="@T("Common_Reason")" maxlength="300" /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_AdjustTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Adjust" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3"><input type="number" name="CountedQuantity" class="form-control" min="0" placeholder="@T("Batches_Counted")" required /></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="@T("Batches_AdjustReason")" maxlength="300" required /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("Batches_DamageTitle")</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Damage" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3"><input type="number" name="Quantity" class="form-control" min="1" placeholder="@T("Common_Quantity")" required /></div>
                            <div class="col-sm-3"><input type="text" name="ReferenceId" class="form-control" placeholder="@T("Batches_Ref")" /></div>
                            <div class="col-sm-2"><button type="submit" class="btn btn-danger w-100">@T("Batches_WriteOff")</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="@T("Batches_DamageReason")" maxlength="300" required /></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><strong>@T("Batches_MovementHistory")</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@T("Common_Date")</th>
                            <th>@T("Common_Type")</th>
                            <th>@T("Common_Quantity")</th>
                            <th>@T("Common_Warehouse")</th>
                            <th>@T("Common_Reference")</th>
                            <th>@T("Common_Reason")</th>
                            <th class="pe-4 text-end">@T("Batches_Col_Correct")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (movements != null && movements.Any())
                        {
                            @foreach (var m in movements)
                            {
                                var transferLeg = m.MovementType == 2 || m.MovementType == 3;
                                <tr>
                                    <td class="ps-4">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge text-bg-@(m.MovementType == 0 || m.MovementType == 2 || m.MovementType == 4 || m.MovementType == 6 ? "success" : "danger")">@MoveType(m.MovementType)</span></td>
                                    <td>@m.Quantity</td>
                                    <td><small>@m.WarehouseId</small></td>
                                    <td><small>@(m.ReferenceId?.ToString() ?? "-")</small></td>
                                    <td><small>@m.Reason</small></td>
                                    <td class="pe-4 text-end">
                                        @if (!transferLeg)
                                        {
                                            <form asp-area="Inventory" asp-controller="Stock" asp-action="ReverseMovement" asp-route-id="@m.Id" method="post" class="d-inline-flex gap-1">
                                                <input type="hidden" name="batchId" value="@Model.Id" />
                                                <input type="text" name="reason" class="form-control form-control-sm" style="max-width: 170px;" placeholder="@T("Batches_CorrectionReason")" required maxlength="290" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@T("Batches_ReverseTitle")">@T("Batches_Reverse")</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <small class="text-muted">@T("Batches_CounterTransfer")</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="py-5 text-center text-muted">@T("Batches_NoMovements")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="mb-5"></div>
</div>
