@model Inventory.Contracts.DTOs.Batch.BatchDetailsDto
@using Inventory.Contracts.DTOs.StockMovement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Batches_DetailsTitle");

    // Translate with a built-in fallback when a key is missing (Loc returns the key itself)
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string key, string? ar = null, string? en = null)
    {
        var v = Loc.T(key);
        if (en != null && v == key) return isAr ? (ar ?? en) : en;
        return v;
    }

    // 0 PurchaseIn, 1 SaleOut, 2 TransferIn, 3 TransferOut, 4 AdjustmentIn, 5 AdjustmentOut, 6 OrderReturn
    string MoveType(int t) => Loc.T(t switch
    {
        0 => "Move_PurchaseIn",
        1 => "Move_SaleOut",
        2 => "Move_TransferIn",
        3 => "Move_TransferOut",
        4 => "Move_AdjustmentIn",
        5 => "Move_AdjustmentOut",
        6 => "Move_OrderReturn",
        _ => "Move_PurchaseIn"
    });
    bool IsIncoming(int t) => t == 0 || t == 2 || t == 4 || t == 6;

    var movements = ((IEnumerable<StockMovementDto>?)ViewBag.Movements)?.ToList() ?? new List<StockMovementDto>();
    var warehouses = (PaginatedResult<WarehouseDto>?)ViewBag.ActiveWarehouses;
    var whItems = warehouses?.Items?.ToList() ?? new List<WarehouseDto>();

    var whPlain = whItems.Select(w => new SelectListItem(w.Name, w.Id.ToString())).ToList();
    var whWithLocation = whItems.Select(w => new SelectListItem(
        string.IsNullOrWhiteSpace(w.Location) ? w.Name : $"{w.Name} ({w.Location})", w.Id.ToString())).ToList();

    var whNames = whItems.GroupBy(w => w.Id.ToString()).ToDictionary(g => g.Key, g => g.First().Name);
    string WarehouseLabel(object id)
    {
        var key = id?.ToString() ?? "-";
        if (whNames.TryGetValue(key, out var name)) return name;
        return key.Length > 8 ? key.Substring(0, 8) : key;
    }

    double initial = Convert.ToDouble(Model.InitialQuantity);
    double Pct(object v) => initial <= 0 ? 0 : Math.Min(100, Math.Max(0, Convert.ToDouble(v) / initial * 100));
    string W(double p) => Math.Round(p, 1).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

    string selectText = T("Common_Select", "اختر…", "Select…");
}

<style>
    /* Everything is scoped to .bd-page and does not depend on Bootstrap's grid or JS */
    .bd-page {
        --bd-line: color-mix(in srgb, currentColor 14%, transparent);
        --bd-line-strong: color-mix(in srgb, currentColor 26%, transparent);
        --bd-card: color-mix(in srgb, currentColor 4%, transparent);
        --bd-muted: color-mix(in srgb, currentColor 62%, transparent);
        --bd-solid: #16181d;
        box-sizing: border-box;
        width: 100%;
        max-width: 1400px;
        margin-inline: auto;
        padding: 1.5rem;
        line-height: 1.5;
    }

        .bd-page *, .bd-page *::before, .bd-page *::after {
            box-sizing: border-box;
        }

        .bd-page h1, .bd-page h2, .bd-page h3, .bd-page p, .bd-page dl, .bd-page dd {
            margin: 0;
        }

    .bd-num {
        direction: ltr;
        unicode-bidi: isolate;
        display: inline-block;
        font-variant-numeric: tabular-nums;
    }

    .bd-muted {
        color: var(--bd-muted);
    }

    /* colour tokens */
    .bd-page .is-blue {
        --c: #4c8dff;
    }

    .bd-page .is-purple {
        --c: #9b7cf6;
    }

    .bd-page .is-amber {
        --c: #d9a441;
    }

    .bd-page .is-green {
        --c: #35b585;
    }

    .bd-page .is-gray {
        --c: #8a94a3;
    }

    .bd-page .is-red {
        --c: #e5534b;
    }

    /* header */
    .bd-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .bd-title {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
        font-size: 1.6rem;
        font-weight: 700;
    }

    .bd-meta {
        margin-top: .35rem;
        font-size: .85rem;
        color: var(--bd-muted);
        display: flex;
        flex-wrap: wrap;
        gap: .25rem 1.25rem;
    }

        .bd-meta code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            overflow-wrap: anywhere;
            color: inherit;
        }

    /* layout */
    .bd-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 22rem;
        gap: 1.25rem;
        align-items: start;
    }

    .bd-main, .bd-side {
        display: grid;
        gap: 1.25rem;
        min-width: 0;
    }

    @@media (max-width: 1100px) {
        .bd-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .bd-side {
            order: -1;
        }
    }

    /* cards */
    .bd-card {
        border: 1px solid var(--bd-line);
        border-radius: .75rem;
        background: var(--bd-card);
        min-width: 0;
    }

    .bd-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: .85rem 1.1rem;
        border-bottom: 1px solid var(--bd-line);
        font-weight: 600;
    }

    .bd-card-body {
        padding: 1.1rem;
    }

    /* summary */
    .bd-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.1rem 1rem;
        margin-bottom: 1.1rem;
    }

    .bd-stat-label {
        font-size: .8rem;
        color: var(--bd-muted);
    }

    .bd-stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.25;
    }

    .bd-bar {
        display: flex;
        height: .6rem;
        border-radius: 999px;
        overflow: hidden;
        background: var(--bd-line);
    }

        .bd-bar > span {
            display: block;
            height: 100%;
        }

    .bd-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem 1rem;
        margin-top: .6rem;
        font-size: .8rem;
        color: var(--bd-muted);
    }

    .bd-dot {
        display: inline-block;
        width: .6rem;
        height: .6rem;
        border-radius: 50%;
        background: var(--c, currentColor);
        flex: none;
    }

    .bd-legend span {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

    .bd-kv {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: .6rem 0;
        border-bottom: 1px solid var(--bd-line);
    }

        .bd-kv:last-of-type {
            border-bottom: 0;
        }

        .bd-kv dt {
            color: var(--bd-muted);
        }

        .bd-kv dd {
            font-weight: 600;
            text-align: end;
        }

    .bd-note {
        display: block;
        margin-top: .6rem;
        font-size: .8rem;
        color: var(--bd-muted);
    }

    /* operations tabs */
    .bd-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        padding: .75rem 1.1rem;
        border-bottom: 1px solid var(--bd-line);
    }

    .bd-tab {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .45rem .8rem;
        border-radius: .5rem;
        border: 1px solid transparent;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: .9rem;
        cursor: pointer;
    }

        .bd-tab:hover {
            background: var(--bd-card);
        }

        .bd-tab.is-active {
            background: var(--bd-card);
            border-color: var(--bd-line-strong);
            font-weight: 600;
        }

    .bd-page :focus-visible {
        outline: 2px solid #4c8dff;
        outline-offset: 2px;
    }

    /* forms */
    .bd-form {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
    }

        .bd-form fieldset {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: 1rem;
            border: 0;
            padding: 0;
            margin: 0;
            min-width: 0;
        }

            .bd-form fieldset:disabled {
                opacity: .5;
            }

        .bd-form .c12 {
            grid-column: span 12;
        }

        .bd-form .c8 {
            grid-column: span 8;
        }

        .bd-form .c6 {
            grid-column: span 6;
        }

        .bd-form .c4 {
            grid-column: span 4;
        }

        .bd-form .c3 {
            grid-column: span 3;
        }

    @@media (max-width: 640px) {
        .bd-form .c8, .bd-form .c6, .bd-form .c4, .bd-form .c3 {
            grid-column: span 12;
        }
    }

    .bd-label {
        display: block;
        margin-bottom: .35rem;
        font-size: .85rem;
        color: var(--bd-muted);
    }

    .bd-input {
        display: block;
        width: 100%;
        padding: .55rem .75rem;
        border-radius: .5rem;
        border: 1px solid var(--bd-line-strong);
        background-color: transparent;
        color: inherit;
        font: inherit;
    }

    select.bd-input {
        background-color: var(--bd-solid);
    }

        select.bd-input option {
            background-color: var(--bd-solid);
            color: inherit;
        }

    .bd-input:focus {
        border-color: #4c8dff;
        outline: none;
        box-shadow: 0 0 0 3px color-mix(in srgb, #4c8dff 25%, transparent);
    }

    .bd-actions {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
    }

        .bd-actions .bd-note {
            margin: 0;
        }

    .bd-error {
        grid-column: 1 / -1;
        color: #e5534b;
        font-size: .85rem;
    }

    /* buttons / badges */
    .bd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .55rem 1.1rem;
        border-radius: .5rem;
        border: 1px solid transparent;
        background: var(--c, #4c8dff);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        margin-inline-start: auto;
    }

        .bd-btn:hover {
            filter: brightness(1.08);
        }

        .bd-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

        .bd-btn.is-amber {
            color: #1b1405;
        }

        .bd-btn.sm {
            padding: .3rem .65rem;
            font-size: .8rem;
            margin-inline-start: 0;
        }

        .bd-btn.ghost {
            background: transparent;
            color: inherit;
            border-color: var(--bd-line-strong);
            font-weight: 500;
            margin-inline-start: 0;
        }

        .bd-btn.ghost-red {
            background: transparent;
            color: #e5534b;
            border-color: color-mix(in srgb, #e5534b 55%, transparent);
            font-weight: 500;
        }

    .bd-badge {
        display: inline-block;
        padding: .15rem .6rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        background: color-mix(in srgb, var(--c, currentColor) 20%, transparent);
        color: var(--c, inherit);
        white-space: nowrap;
    }

        .bd-badge.neutral {
            --c: #8a94a3;
        }

    /* history table */
    .bd-table-wrap {
        overflow-x: auto;
    }

    .bd-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .9rem;
    }

        .bd-table th {
            text-align: start;
            font-weight: 600;
            font-size: .8rem;
            color: var(--bd-muted);
            padding: .65rem .9rem;
            border-bottom: 1px solid var(--bd-line);
            white-space: nowrap;
            background: var(--bd-card);
        }

        .bd-table td {
            padding: .7rem .9rem;
            border-bottom: 1px solid var(--bd-line);
            vertical-align: middle;
            white-space: nowrap;
        }

        .bd-table tr:last-child td {
            border-bottom: 0;
        }

        .bd-table tbody tr:hover {
            background: var(--bd-card);
        }

        .bd-table td.wrap {
            white-space: normal;
            min-width: 9rem;
            max-width: 18rem;
        }

    .bd-qty {
        font-weight: 700;
    }

        .bd-qty.in {
            color: #35b585;
        }

        .bd-qty.out {
            color: #e5534b;
        }

    .bd-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--bd-muted);
    }

    /* alerts */
    .bd-alert {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .75rem 1rem;
        border-radius: .6rem;
        margin-bottom: 1rem;
        border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
        background: color-mix(in srgb, var(--c) 14%, transparent);
    }

        .bd-alert button {
            background: none;
            border: 0;
            color: inherit;
            font-size: 1.25rem;
            line-height: 1;
            cursor: pointer;
            opacity: .7;
        }

    /* reverse dialog */
    dialog.bd-dialog {
        width: calc(100% - 2rem);
        max-width: 28rem;
        padding: 0;
        border: 1px solid var(--bd-line-strong);
        border-radius: .75rem;
        background: var(--bd-solid);
        color: inherit;
    }

        dialog.bd-dialog::backdrop {
            background: rgba(0, 0, 0, .55);
        }

    .bd-dialog-head {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--bd-line);
        font-weight: 700;
    }

    .bd-dialog-body {
        padding: 1.25rem;
        display: grid;
        gap: .9rem;
    }

    .bd-dialog-foot {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--bd-line);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

        .bd-dialog-foot .bd-btn {
            margin-inline-start: 0;
        }
</style>

<div class="bd-page">

    @if (TempData["Success"] != null)
    {
        <div class="bd-alert is-green" role="alert">
            <span>@TempData["Success"]</span>
            <button type="button" data-dismiss-alert aria-label="Close">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bd-alert is-red" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" data-dismiss-alert aria-label="Close">&times;</button>
        </div>
    }

    @* ───────── Header ───────── *@
    <div class="bd-head">
        <div>
            <h1 class="bd-title">
                @T("Batches_DetailsTitle")
                @if (Model.IsExhausted)
                {
                    <span class="bd-badge neutral">@T("Batches_FullyAllocated")</span>
                }
            </h1>
            <div class="bd-meta">
                <span>@T("Common_Product"): <code>@Model.ProductId</code></span>
                <span>@T("Batches_PurchaseItemId"): <code>@Model.PurchaseItemId</code></span>
            </div>
        </div>
        <a class="bd-btn ghost" asp-area="Inventory" asp-controller="Batches" asp-action="Index">@T("Batches_BackToList")</a>
    </div>

    <div class="bd-grid">

        @* ───────── Main: operations + history ───────── *@
        <div class="bd-main">

            <section class="bd-card">
                <div class="bd-card-head">@T("Batches_Actions", "العمليات", "Operations")</div>

                <div class="bd-tabs" role="tablist">
                    <button type="button" class="bd-tab is-blue is-active" data-pane="pane-allocate" role="tab" aria-selected="true"><span class="bd-dot"></span>@T("Batches_AllocateTitle")</button>
                    <button type="button" class="bd-tab is-purple" data-pane="pane-transfer" role="tab" aria-selected="false"><span class="bd-dot"></span>@T("Batches_TransferTitle")</button>
                    <button type="button" class="bd-tab is-amber" data-pane="pane-sale" role="tab" aria-selected="false"><span class="bd-dot"></span>@T("Batches_SaleTitle")</button>
                    <button type="button" class="bd-tab is-green" data-pane="pane-return" role="tab" aria-selected="false"><span class="bd-dot"></span>@T("Batches_ReturnTitle")</button>
                    <button type="button" class="bd-tab is-gray" data-pane="pane-adjust" role="tab" aria-selected="false"><span class="bd-dot"></span>@T("Batches_AdjustTitle")</button>
                    <button type="button" class="bd-tab is-red" data-pane="pane-damage" role="tab" aria-selected="false"><span class="bd-dot"></span>@T("Batches_DamageTitle")</button>
                </div>

                <div class="bd-card-body">

                    @* Allocate *@
                    <div class="bd-pane" id="pane-allocate" role="tabpanel">
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Allocate" method="post" class="bd-form js-once">
                            <div asp-validation-summary="ModelOnly" class="bd-error"></div>
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <fieldset disabled="@(Model.RemainingQuantity <= 0)">
                                <div class="c8">
                                    <label class="bd-label">@T("Common_Warehouse")</label>
                                    <select name="WarehouseId" class="bd-input" asp-items="whWithLocation" required>
                                        <option value="">@selectText</option>
                                    </select>
                                </div>
                                <div class="c4">
                                    <label class="bd-label">@T("Common_Quantity")</label>
                                    <input type="number" name="Quantity" class="bd-input" min="1" max="@Model.RemainingQuantity" required />
                                </div>
                                <div class="bd-actions">
                                    <small class="bd-note">@Loc.F("Batches_AllocateNote", Model.RemainingQuantity)</small>
                                    <button type="submit" class="bd-btn is-blue">@T("Batches_Allocate")</button>
                                </div>
                            </fieldset>
                        </form>
                    </div>

                    @* Transfer *@
                    <div class="bd-pane" id="pane-transfer" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Transfer" method="post" class="bd-form js-once" id="transferForm">
                            <div asp-validation-summary="ModelOnly" class="bd-error"></div>
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="c6">
                                <label class="bd-label">@T("Batches_Source")</label>
                                <select name="SourceWarehouseId" class="bd-input" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="c6">
                                <label class="bd-label">@T("Batches_Destination")</label>
                                <select name="DestinationWarehouseId" class="bd-input" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="c4">
                                <label class="bd-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="bd-input" min="1" required />
                            </div>
                            <div class="c8">
                                <label class="bd-label">@T("Batches_ReasonOptional")</label>
                                <input type="text" name="Reason" class="bd-input" maxlength="300" />
                            </div>
                            <div class="bd-actions">
                                <small class="bd-note">@T("Batches_TransferNote")</small>
                                <button type="submit" class="bd-btn is-purple">@T("Batches_Transfer", "تحويل", "Transfer")</button>
                            </div>
                        </form>
                    </div>

                    @* Sale *@
                    <div class="bd-pane" id="pane-sale" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Sale" method="post" class="bd-form js-once">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="c4">
                                <label class="bd-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="bd-input" min="1" required />
                            </div>
                            <div class="c8">
                                <label class="bd-label">@T("Batches_OrderRef")</label>
                                <input type="text" name="OrderReferenceId" class="bd-input" />
                            </div>
                            <div class="c12">
                                <label class="bd-label">@T("Common_Reason")</label>
                                <input type="text" name="Reason" class="bd-input" maxlength="300" />
                            </div>
                            <div class="bd-actions">
                                <button type="submit" class="bd-btn is-amber">@T("Batches_SaleOut")</button>
                            </div>
                        </form>
                    </div>

                    @* Return *@
                    <div class="bd-pane" id="pane-return" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Return" method="post" class="bd-form js-once">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="c4">
                                <label class="bd-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="bd-input" min="1" required />
                            </div>
                            <div class="c8">
                                <label class="bd-label">@T("Batches_OriginalOrder")</label>
                                <input type="text" name="OrderReferenceId" class="bd-input" />
                            </div>
                            <div class="c12">
                                <label class="bd-label">@T("Common_Reason")</label>
                                <input type="text" name="Reason" class="bd-input" maxlength="300" />
                            </div>
                            <div class="bd-actions">
                                <button type="submit" class="bd-btn is-green">@T("Batches_ReturnIn")</button>
                            </div>
                        </form>
                    </div>

                    @* Adjust *@
                    <div class="bd-pane" id="pane-adjust" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Adjust" method="post" class="bd-form js-once">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="c8">
                                <label class="bd-label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="bd-input" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="c4">
                                <label class="bd-label">@T("Batches_Counted")</label>
                                <input type="number" name="CountedQuantity" class="bd-input" min="0" required />
                            </div>
                            <div class="c12">
                                <label class="bd-label">@T("Batches_AdjustReason")</label>
                                <input type="text" name="Reason" class="bd-input" maxlength="300" required />
                            </div>
                            <div class="bd-actions">
                                <button type="submit" class="bd-btn is-gray">@T("Batches_Adjust", "حفظ الجرد", "Save count")</button>
                            </div>
                        </form>
                    </div>

                    @* Damage *@
                    <div class="bd-pane" id="pane-damage" role="tabpanel" hidden>
                        <form asp-area="Inventory" asp-controller="Stock" asp-action="Damage" method="post" class="bd-form js-once">
                            <input type="hidden" name="BatchId" value="@Model.Id" />
                            <div class="c6">
                                <label class="bd-label">@T("Common_Warehouse")</label>
                                <select name="WarehouseId" class="bd-input" asp-items="whPlain" required>
                                    <option value="">@selectText</option>
                                </select>
                            </div>
                            <div class="c3">
                                <label class="bd-label">@T("Common_Quantity")</label>
                                <input type="number" name="Quantity" class="bd-input" min="1" required />
                            </div>
                            <div class="c3">
                                <label class="bd-label">@T("Batches_Ref")</label>
                                <input type="text" name="ReferenceId" class="bd-input" />
                            </div>
                            <div class="c12">
                                <label class="bd-label">@T("Batches_DamageReason")</label>
                                <input type="text" name="Reason" class="bd-input" maxlength="300" required />
                            </div>
                            <div class="bd-actions">
                                <button type="submit" class="bd-btn is-red">@T("Batches_WriteOff")</button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            @* ───────── Movement history ───────── *@
            <section class="bd-card">
                <div class="bd-card-head">
                    <span>@T("Batches_MovementHistory")</span>
                    <span class="bd-badge neutral"><span class="bd-num">@movements.Count</span></span>
                </div>
                <div class="bd-table-wrap">
                    <table class="bd-table">
                        <thead>
                            <tr>
                                <th>@T("Common_Date")</th>
                                <th>@T("Common_Type")</th>
                                <th>@T("Common_Quantity")</th>
                                <th>@T("Common_Warehouse")</th>
                                <th>@T("Common_Reference")</th>
                                <th>@T("Common_Reason")</th>
                                <th>@T("Batches_Col_Correct")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (movements.Count > 0)
                            {
                                foreach (var m in movements)
                                {
                                    var incoming = IsIncoming(m.MovementType);
                                    var transferLeg = m.MovementType == 2 || m.MovementType == 3;
                                    <tr>
                                        <td><span class="bd-num">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                                        <td><span class="bd-badge @(incoming ? "is-green" : "is-red")">@MoveType(m.MovementType)</span></td>
                                        <td><span class="bd-num bd-qty @(incoming ? "in" : "out")">@(incoming ? "+" : "-")@m.Quantity</span></td>
                                        <td>@WarehouseLabel(m.WarehouseId)</td>
                                        <td class="bd-muted">@(m.ReferenceId?.ToString() ?? "-")</td>
                                        <td class="wrap bd-muted">@(string.IsNullOrWhiteSpace(m.Reason) ? "-" : m.Reason)</td>
                                        <td>
                                            @if (!transferLeg)
                                            {
                                                <button type="button" class="bd-btn sm ghost-red"
                                                        data-reverse-url="@Url.Action("ReverseMovement", "Stock", new { area = "Inventory", id = m.Id })"
                                                        data-summary="@MoveType(m.MovementType) (@m.Quantity)"
                                                        title="@T("Batches_ReverseTitle")">
                                                    @T("Batches_Reverse")
                                                </button>
                                            }
                                            else
                                            {
                                                <small class="bd-muted">@T("Batches_CounterTransfer")</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="bd-empty">@T("Batches_NoMovements")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        @* ───────── Side: quantities + cost ───────── *@
        <aside class="bd-side">

            <section class="bd-card">
                <div class="bd-card-head">@T("Batches_QuantitiesTitle")</div>
                <div class="bd-card-body">
                    <div class="bd-stats">
                        <div>
                            <div class="bd-stat-label">@T("Batches_InitialReceived")</div>
                            <div class="bd-stat-value"><span class="bd-num">@Model.InitialQuantity</span></div>
                        </div>
                        <div>
                            <div class="bd-stat-label">@T("Batches_UnallocatedRemaining")</div>
                            <div class="bd-stat-value"><span class="bd-num">@Model.RemainingQuantity</span></div>
                        </div>
                        <div>
                            <div class="bd-stat-label">@T("Batches_InWarehouses")</div>
                            <div class="bd-stat-value"><span class="bd-num">@Model.QuantityInWarehouses</span></div>
                        </div>
                        <div>
                            <div class="bd-stat-label">@T("Batches_EverAllocated")</div>
                            <div class="bd-stat-value"><span class="bd-num">@Model.AllocatedQuantity</span></div>
                        </div>
                    </div>

                    <div class="bd-bar" role="img" aria-label="@T("Batches_UnallocatedRemaining") / @T("Batches_InWarehouses")">
                        <span style="width:@W(Pct(Model.RemainingQuantity)); background:#d9a441"></span>
                        <span style="width:@W(Pct(Model.QuantityInWarehouses)); background:#35b585"></span>
                    </div>
                    <div class="bd-legend">
                        <span><i class="bd-dot" style="--c:#d9a441"></i>@T("Batches_UnallocatedRemaining")</span>
                        <span><i class="bd-dot" style="--c:#35b585"></i>@T("Batches_InWarehouses")</span>
                    </div>
                </div>
            </section>

            <section class="bd-card">
                <div class="bd-card-head">@T("Batches_CostTitle")</div>
                <div class="bd-card-body">
                    <dl>
                        <div class="bd-kv"><dt>@T("Batches_UnitCost")</dt><dd><span class="bd-num">@Model.UnitCost.ToString("N2")</span></dd></div>
                        <div class="bd-kv"><dt>@T("Batches_InitialTotalCost")</dt><dd><span class="bd-num">@Model.InitialTotalCost.ToString("N2")</span></dd></div>
                        <div class="bd-kv"><dt>@T("Batches_RemainingValue")</dt><dd><span class="bd-num">@Model.RemainingValue.ToString("N2")</span></dd></div>
                        <div class="bd-kv"><dt>@T("Batches_ReceivedAt")</dt><dd><span class="bd-num">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span></dd></div>
                    </dl>
                    <small class="bd-note">@T("Batches_CostNote")</small>
                </div>
            </section>
        </aside>
    </div>

    @* One shared dialog for reversing any movement *@
    <dialog class="bd-dialog" id="bdReverseDialog" aria-labelledby="bdReverseTitle">
        <form method="post" id="bdReverseForm" class="js-once" asp-antiforgery="false">
            @Html.AntiForgeryToken()
            <input type="hidden" name="batchId" value="@Model.Id" />
            <div class="bd-dialog-head" id="bdReverseTitle">@T("Batches_ReverseTitle")</div>
            <div class="bd-dialog-body">
                <div id="bdReverseSummary" style="font-weight:600"></div>
                <div>
                    <label class="bd-label" for="bdReverseReason">@T("Batches_CorrectionReason")</label>
                    <input type="text" id="bdReverseReason" name="reason" class="bd-input" required maxlength="290" />
                </div>
            </div>
            <div class="bd-dialog-foot">
                <button type="button" class="bd-btn ghost" id="bdReverseCancel">@T("Common_Cancel", "إلغاء", "Cancel")</button>
                <button type="submit" class="bd-btn is-red">@T("Batches_Reverse")</button>
            </div>
        </form>
    </dialog>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var page = document.querySelector('.bd-page');
        if (!page) return;

        // 0) Solid surface colour (for select dropdowns / dialog), taken from the app's own theme
        (function () {
            var el = page.parentElement;
            while (el) {
                var c = getComputedStyle(el).backgroundColor;
                if (c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent') { page.style.setProperty('--bd-solid', c); return; }
                el = el.parentElement;
            }
            var t = (getComputedStyle(page).color.match(/\d+/g) || [0, 0, 0]).map(Number);
            var lum = 0.299 * t[0] + 0.587 * t[1] + 0.114 * t[2];
            page.style.setProperty('--bd-solid', lum > 140 ? '#16181d' : '#ffffff');
        })();

        // 1) Operation tabs (remembers the last one, so a failed submit lands on the same form)
        var key = 'batch-details-tab';
        var tabs = Array.prototype.slice.call(page.querySelectorAll('.bd-tab'));
        var panes = Array.prototype.slice.call(page.querySelectorAll('.bd-pane'));
        function show(id, remember) {
            tabs.forEach(function (t) {
                var on = t.getAttribute('data-pane') === id;
                t.classList.toggle('is-active', on);
                t.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            panes.forEach(function (p) { p.hidden = p.id !== id; });
            if (remember) { try { sessionStorage.setItem(key, id); } catch (e) { } }
        }
        tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-pane'), true); }); });
        try {
            var saved = sessionStorage.getItem(key);
            if (saved && document.getElementById(saved)) show(saved, false);
        } catch (e) { }

        // 2) Reverse dialog
        var dlg = document.getElementById('bdReverseDialog');
        var rform = document.getElementById('bdReverseForm');
        var rreason = document.getElementById('bdReverseReason');
        var rsummary = document.getElementById('bdReverseSummary');
        page.querySelectorAll('[data-reverse-url]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                rform.action = btn.getAttribute('data-reverse-url');
                rsummary.textContent = btn.getAttribute('data-summary') || '';
                rreason.value = '';
                if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
                rreason.focus();
            });
        });
        document.getElementById('bdReverseCancel').addEventListener('click', function () { dlg.close(); });
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });

        // 3) Transfer: source and destination can't be the same warehouse
        var tf = document.getElementById('transferForm');
        if (tf) {
            var src = tf.querySelector('[name="SourceWarehouseId"]');
            var dst = tf.querySelector('[name="DestinationWarehouseId"]');
            var sync = function () {
                Array.prototype.forEach.call(dst.options, function (o) { o.disabled = o.value !== '' && o.value === src.value; });
                if (dst.value === src.value) dst.value = '';
            };
            src.addEventListener('change', sync);
            sync();
        }

        // 4) Prevent double submits (a double click would post the stock movement twice)
        page.querySelectorAll('form.js-once').forEach(function (f) {
            f.addEventListener('submit', function () {
                if (!f.checkValidity()) return;
                setTimeout(function () {
                    f.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
                }, 0);
            });
        });

        // 5) Dismissible alerts
        page.querySelectorAll('[data-dismiss-alert]').forEach(function (b) {
            b.addEventListener('click', function () { b.closest('.bd-alert').remove(); });
        });
    });
</script>
