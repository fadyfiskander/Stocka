@model PaginatedResult<BatchDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = (Loc.IsEn ? "Batches" : "الدفعات");
    var productId = (Guid?)ViewBag.ProductId;
    var purchaseItemId = (Guid?)ViewBag.PurchaseItemId;
    var warehouseId = (Guid?)ViewBag.WarehouseId;

    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string btnPrimary = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-accent px-4 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover hover:no-underline";
    const string rowBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-2.5 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageOff = "inline-flex h-8 cursor-not-allowed items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-faint opacity-45";
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
            <h1 class="text-[22px] font-bold tracking-[-.015em]">@(Loc.IsEn ? "Batches" : "الدفعات")</h1>
            <p class="mt-1.5 max-w-[80ch] text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Received stock batches. RemainingQuantity = units not yet allocated to warehouses." : "دفعات المخزون المستلمة. الكمية المتبقية = وحدات لم تُخصَّص للمستودعات بعد.")</p>
        </div>
        <a class="@btnPrimary" asp-area="Inventory" asp-controller="Batches" asp-action="Create">
            <svg class="icon !size-4"><use href="#i-plus" /></svg>@(Loc.IsEn ? "Register batch" : "تسجيل دفعة")
        </a>
    </header>

    <form method="get" asp-area="Inventory" asp-controller="Batches" asp-action="Index"
          class="rounded-lg border border-line bg-surface p-4 shadow-card">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto_auto] lg:items-end">
            <input type="text" name="productId" class="@input num font-mono" placeholder="@(Loc.IsEn ? "Product ID (Guid)" : "معرّف المنتج (Guid)")" value="@productId" />
            <input type="text" name="purchaseItemId" class="@input num font-mono" placeholder="@(Loc.IsEn ? "Purchase item ID (Guid)" : "معرّف بند الشراء (Guid)")" value="@purchaseItemId" />
            <input type="text" name="warehouseId" class="@input num font-mono" placeholder="@(Loc.IsEn ? "Warehouse holding stock" : "المستودع الحامل للمخزون")" value="@warehouseId" />
            <button type="submit" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken">
                <svg class="icon !size-4"><use href="#i-filter" /></svg>@(Loc.IsEn ? "Filter" : "تصفية")
            </button>
            <a class="inline-flex h-10 items-center justify-center rounded-md px-4 text-[13.5px] font-medium text-ink-soft transition-colors hover:bg-sunken hover:text-ink hover:no-underline"
               asp-area="Inventory" asp-controller="Batches" asp-action="Index">@(Loc.IsEn ? "Clear" : "مسح")</a>
        </div>
    </form>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Batch" : "الدفعة")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Product" : "المنتج")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Initial" : "الأولي")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Unallocated" : "غير مخصَّص")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Unit cost" : "تكلفة الوحدة")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Received" : "تاريخ الاستلام")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Actions" : "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var batch in Model.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@batch.Id</span></td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@batch.ProductId</span></td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@batch.InitialQuantity</td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@batch.RemainingQuantity</td>
                                <td class="num px-4 py-3 text-end text-ink-soft">@batch.UnitCost.ToString("N2")</td>
                                <td class="num px-4 py-3 font-mono text-[12.5px] text-ink-soft">@batch.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end">
                                        <a class="@rowBtn" asp-area="Inventory" asp-controller="Batches" asp-action="Details" asp-route-id="@batch.Id">@(Loc.IsEn ? "Details" : "التفاصيل")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-14 text-center">
                                <svg class="icon mx-auto !size-8 text-ink-faint"><use href="#i-layers" /></svg>
                                <p class="mt-2 text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No batches found." : "لا توجد دفعات.")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-[12.5px] text-ink-faint">@(Loc.IsEn ? $"Page {Model.Page} of {Model.TotalPages} ({Model.TotalCount} batches)" : $"صفحة {Model.Page} من {Model.TotalPages} ({Model.TotalCount} دفعة)")</span>
        <div class="flex items-center gap-1.5">
            @if (Model.HasPrevious)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Batches" asp-action="Index" asp-route-productId="@productId" asp-route-purchaseItemId="@purchaseItemId" asp-route-warehouseId="@warehouseId" asp-route-page="@(Model.Page - 1)">
                    <svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@(Loc.IsEn ? "Previous" : "السابق")
                </a>
            }
            else
            {
                <span class="@pageOff"><svg class="icon !size-4"><use href="#i-chevron-start" /></svg>@(Loc.IsEn ? "Previous" : "السابق")</span>
            }
            @if (Model.HasNext)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Batches" asp-action="Index" asp-route-productId="@productId" asp-route-purchaseItemId="@purchaseItemId" asp-route-warehouseId="@warehouseId" asp-route-page="@(Model.Page + 1)">
                    @(Loc.IsEn ? "Next" : "التالي")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg>
                </a>
            }
            else
            {
                <span class="@pageOff">@(Loc.IsEn ? "Next" : "التالي")<svg class="icon !size-4"><use href="#i-chevron-end" /></svg></span>
            }
        </div>
    </div>
</section>
