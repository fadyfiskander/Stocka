@model PaginatedResult<BatchDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Batches_Title");
    string T(string key) => Loc.T(key);
    var productId = (Guid?)ViewBag.ProductId;
    var purchaseItemId = (Guid?)ViewBag.PurchaseItemId;
    var warehouseId = (Guid?)ViewBag.WarehouseId;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@T("Batches_Title")</h2>
            <p class="text-muted mb-0">@T("Batches_Sub")</p>
        </div>
        <a class="btn btn-primary" asp-area="Inventory" asp-controller="Batches" asp-action="Create">@T("Batches_Register")</a>
    </div>

    <form method="get" class="row g-2 mb-3" asp-area="Inventory" asp-controller="Batches" asp-action="Index">
        <div class="col-md-4"><input type="text" class="form-control" name="productId" placeholder="@T("Batches_FilterProduct")" value="@productId" /></div>
        <div class="col-md-4"><input type="text" class="form-control" name="purchaseItemId" placeholder="@T("Batches_FilterPurchase")" value="@purchaseItemId" /></div>
        <div class="col-md-3"><input type="text" class="form-control" name="warehouseId" placeholder="@T("Batches_FilterWarehouse")" value="@warehouseId" /></div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-primary">@T("Common_Filter")</button></div>
        <div class="col-auto"><a class="btn btn-outline-secondary" asp-area="Inventory" asp-controller="Batches" asp-action="Index">@T("Common_Clear")</a></div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@T("Common_Batch")</th>
                            <th>@T("Common_Product")</th>
                            <th>@T("Batches_Col_Initial")</th>
                            <th>@T("Batches_Col_Unallocated")</th>
                            <th>@T("Batches_Col_UnitCost")</th>
                            <th>@T("Batches_Col_Received")</th>
                            <th class="pe-4 text-end">@T("Common_Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var batch in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4"><small>@batch.Id</small></td>
                                    <td><small>@batch.ProductId</small></td>
                                    <td>@batch.InitialQuantity</td>
                                    <td>@batch.RemainingQuantity</td>
                                    <td>@batch.UnitCost.ToString("N2")</td>
                                    <td>@batch.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="pe-4 text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-area="Inventory" asp-controller="Batches" asp-action="Details" asp-route-id="@batch.Id">@T("Common_Details")</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="py-5 text-center text-muted">@T("Batches_Empty")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">@Loc.F("Batches_PageInfo", Model.Page, Model.TotalPages, Model.TotalCount)</small>
        <div class="btn-group">
            <a asp-area="Inventory" asp-controller="Batches" asp-action="Index" asp-route-productId="@productId" asp-route-purchaseItemId="@purchaseItemId" asp-route-warehouseId="@warehouseId" asp-route-page="@(Model.Page - 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")">@T("Common_Previous")</a>
            <a asp-area="Inventory" asp-controller="Batches" asp-action="Index" asp-route-productId="@productId" asp-route-purchaseItemId="@purchaseItemId" asp-route-warehouseId="@warehouseId" asp-route-page="@(Model.Page + 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")">@T("Common_Next")</a>
        </div>
    </div>
</div>
