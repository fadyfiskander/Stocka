@model Inventory.Contracts.UseCases.BatchCases.RegisterBatchCommand
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Batches_CreateTitle");
    string T(string key) => Loc.T(key);

    const string label = "mb-1.5 block text-[12.5px] font-semibold text-ink-soft";
    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition placeholder:text-ink-faint hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string err = "mt-1.5 block text-[12px] font-medium text-danger";
}

<div class="mx-auto max-w-[42rem]">
    <header class="mb-5 border-b border-line pb-5">
        <h1 class="text-[24px] font-bold tracking-[-.02em]">@T("Batches_CreateTitle")</h1>
        <p class="mt-1.5 max-w-[70ch] text-[13.5px] text-ink-soft">@T("Batches_CreateSub")</p>
    </header>

    <form asp-area="Inventory" asp-controller="Batches" asp-action="Create" method="post"
          class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="grid gap-5 p-5 sm:p-7">
            <div asp-validation-summary="ModelOnly" class="rounded-md border border-danger/30 bg-danger-tint px-4 py-3 text-[13px] text-danger empty:hidden"></div>

            <div>
                <label class="@label" asp-for="ProductId">@T("Batches_ProductId")</label>
                <input class="@input num font-mono" asp-for="ProductId" placeholder="00000000-0000-0000-0000-000000000000" />
                <span asp-validation-for="ProductId" class="@err"></span>
            </div>

            <div>
                <label class="@label" asp-for="PurchaseItemId">@T("Batches_PurchaseItemId")</label>
                <input class="@input num font-mono" asp-for="PurchaseItemId" placeholder="00000000-0000-0000-0000-000000000000" />
                <span asp-validation-for="PurchaseItemId" class="@err"></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label class="@label" asp-for="InitialQuantity">@T("Batches_InitialQty")</label>
                    <input type="number" class="@input num" asp-for="InitialQuantity" min="1" />
                    <span asp-validation-for="InitialQuantity" class="@err"></span>
                </div>
                <div>
                    <label class="@label" asp-for="UnitCost">@T("Batches_UnitCost")</label>
                    <input type="number" step="0.01" class="@input num" asp-for="UnitCost" min="0.01" />
                    <span asp-validation-for="UnitCost" class="@err"></span>
                </div>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-2.5 border-t border-line bg-sunken/40 px-5 py-4 sm:flex-row sm:justify-end sm:px-7">
            <a class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline"
               asp-area="Inventory" asp-controller="Batches" asp-action="Index">@T("Common_Cancel")</a>
            <button type="submit" class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover">
                <svg class="icon !size-4"><use href="#i-plus" /></svg>@T("Batches_RegisterAction")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
