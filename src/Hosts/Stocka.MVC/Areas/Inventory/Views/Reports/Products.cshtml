@model PaginatedResult<ZeroStockProductDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("ReportProducts_Title");
    string T(string key) => Loc.T(key);
}

<div class="container-fluid py-4">
    <h2 class="mb-1">@T("ReportProducts_Title")</h2>
    <p class="text-muted mb-3">
        @T("ReportProducts_Sub")
    </p>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table-hover mb-0 table align-middle">
                <thead class="table-light">
                    <tr><th class="ps-4">@T("Common_Product")</th><th>@T("ReportProducts_Col_Initial")</th><th>@T("Batches_Col_Unallocated")</th><th>@T("Batches_InWarehouses")</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var p in Model.Items)
                         {
                             <tr>
                                 <td class="ps-4"><small>@p.ProductId</small></td>
                                 <td>@p.InitialQuantity</td>
                                 <td>@p.UnallocatedQuantity</td>
                                 <td>@p.QuantityInWarehouses</td>
                             </tr>
                         }
                    }
                    else
                    {
                        <tr><td colspan="4" class="py-5 text-center text-muted">@T("ReportProducts_Empty")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">@Loc.F("Common_PageOf", Model.Page, Model.TotalPages) (@Model.TotalCount)</small>
        <div class="btn-group">
            <a asp-area="Inventory" asp-controller="Reports" asp-action="Products" asp-route-page="@(Model.Page - 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")">@T("Common_Previous")</a>
            <a asp-area="Inventory" asp-controller="Reports" asp-action="Products" asp-route-page="@(Model.Page + 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")">@T("Common_Next")</a>
        </div>
    </div>
    <div class="mb-5"></div>
</div>
