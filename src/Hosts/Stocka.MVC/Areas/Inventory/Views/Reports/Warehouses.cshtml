@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("ReportWarehouses_Title");
    string T(string key) => Loc.T(key);
    var rankedStock = (PaginatedResult<WarehouseStockSummaryDto>?)ViewBag.RankedByStock;
    var rankedCost = (PaginatedResult<WarehouseStockSummaryDto>?)ViewBag.RankedByCost;
    var zeroStock = (List<WarehouseStockSummaryDto>?)ViewBag.ZeroStock;
    var inactiveWithStock = (List<WarehouseStockSummaryDto>?)ViewBag.InactiveWithStock;
    var asc = (bool)ViewBag.Ascending;
}

<div class="container-fluid py-4">
    <h2 class="mb-1">@T("ReportWarehouses_Title")</h2>
    <p class="text-muted mb-3">
        @T("ReportWarehouses_Sub")
    </p>

    <div class="btn-group mb-3">
        <a class="btn btn-sm btn-outline-secondary" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses" asp-route-order="stock" asp-route-asc="@(asc)">@Loc.F("ReportWarehouses_ByStock", (asc ? T("ReportWarehouses_Asc") : T("ReportWarehouses_Desc")))</a>
        <a class="btn btn-sm btn-outline-secondary" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses" asp-route-order="cost" asp-route-asc="@(asc)">@Loc.F("ReportWarehouses_ByCost", (asc ? T("ReportWarehouses_Asc") : T("ReportWarehouses_Desc")))</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("ReportWarehouses_RankStock")</strong></div>
                <div class="card-body p-0">
                    <table class="table-hover mb-0 table align-middle">
                        <thead class="table-light"><tr><th class="ps-4">@T("Common_Warehouse")</th><th>@T("ReportWarehouses_Col_Active")</th><th>@T("ReportWarehouses_Col_Units")</th><th class="pe-4 text-end">@T("ReportWarehouses_Col_Products")</th></tr></thead>
                        <tbody>
                            @if (rankedStock != null)
                            {
                                @foreach (var w in rankedStock.Items)
                                 {
                                     <tr><td class="ps-4">@w.Name</td><td>@(w.IsActive ? T("Common_Yes") : T("Common_No"))</td><td>@w.TotalUnits</td><td class="pe-4 text-end">@w.DistinctProducts</td></tr>
                                 }
                                 if (!rankedStock.Items.Any())
                                 {
                                     <tr><td colspan="4" class="py-4 text-center text-muted">@T("ReportWarehouses_None")</td></tr>
                                 }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>@T("ReportWarehouses_RankCost")</strong></div>
                <div class="card-body p-0">
                    <table class="table-hover mb-0 table align-middle">
                        <thead class="table-light"><tr><th class="ps-4">@T("Common_Warehouse")</th><th>@T("ReportWarehouses_Col_Units")</th><th class="pe-4 text-end">@T("ReportWarehouses_Col_Cost")</th></tr></thead>
                        <tbody>
                            @if (rankedCost != null)
                            {
                                @foreach (var w in rankedCost.Items)
                                 {
                                     <tr><td class="ps-4">@w.Name</td><td>@w.TotalUnits</td><td class="pe-4 text-end">@w.TotalCost.ToString("N2")</td></tr>
                                 }
                                 if (!rankedCost.Items.Any())
                                 {
                                     <tr><td colspan="3" class="py-4 text-center text-muted">@T("ReportWarehouses_None")</td></tr>
                                 }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><strong>@T("ReportWarehouses_Zero")</strong></div>
                <div class="card-body p-0">
                    <table class="table-hover mb-0 table align-middle">
                        <thead class="table-light"><tr><th class="ps-4">@T("Common_Warehouse")</th><th>@T("Common_Status")</th></tr></thead>
                        <tbody>
                            @if (zeroStock != null && zeroStock.Any())
                            {
                                @foreach (var w in zeroStock)
                                 {
                                     <tr><td class="ps-4">@w.Name</td><td><span class="badge text-bg-@(w.IsActive ? "success" : "secondary")">@(w.IsActive ? T("Common_Active") : T("Common_Inactive"))</span></td></tr>
                                 }
                            }
                            else
                            {
                                <tr><td colspan="2" class="py-4 text-center text-muted">@T("ReportWarehouses_AllHold")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><strong>@T("ReportWarehouses_Inactive")</strong></div>
                <div class="card-body p-0">
                    <table class="table-hover mb-0 table align-middle">
                        <thead class="table-light"><tr><th class="ps-4">@T("Common_Warehouse")</th><th>@T("ReportWarehouses_Col_Units")</th><th class="pe-4 text-end">@T("ReportWarehouses_Col_Cost")</th></tr></thead>
                        <tbody>
                            @if (inactiveWithStock != null && inactiveWithStock.Any())
                            {
                                @foreach (var w in inactiveWithStock)
                                 {
                                     <tr><td class="ps-4 text-warning-emphasis">@w.Name</td><td>@w.TotalUnits</td><td class="pe-4 text-end">@w.TotalCost.ToString("N2")</td></tr>
                                 }
                            }
                            else
                            {
                                <tr><td colspan="3" class="py-4 text-center text-muted">@T("ReportWarehouses_NoneInactive")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-5"></div>
</div>
