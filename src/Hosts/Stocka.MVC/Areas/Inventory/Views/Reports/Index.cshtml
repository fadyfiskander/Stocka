@model Inventory.Contracts.DTOs.Reports.InventorySummaryDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Reports_Title");
    string T(string key) => Loc.T(key);
    string MoveType(int t) => Loc.T(t switch
    {
        0 => "Move_PurchaseIn",
        1 => "Move_SaleOut",
        2 => "Move_TransferIn",
        3 => "Move_TransferOut",
        4 => "Move_AdjustmentIn",
        5 => "Move_AdjustmentOut",
        6 => "Move_OrderReturn",
        _ => "Move_PurchaseIn"
    });
    bool IsIncoming(int t) => t == 0 || t == 2 || t == 4 || t == 6;
    var totals = (IEnumerable<MovementTypeTotalsDto>?)ViewBag.MovementTotals;

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
}

<section class="grid gap-5">
    <header class="border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Reports_Title")</h1>
        <p class="mt-1.5 text-[13.5px] text-ink-soft">@Loc.F("Reports_Sub", Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm"))</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <svg class="icon !size-[15px] text-accent"><use href="#i-store" /></svg>@T("Reports_TotalWarehouses")
            </div>
            <div class="mt-1.5 flex items-baseline gap-2">
                <span class="num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.TotalWarehouses</span>
                <span class="text-[11.5px] font-semibold text-ok">@Loc.F("Reports_ActiveCount", Model.ActiveWarehouses)</span>
            </div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <svg class="icon !size-[15px] text-accent"><use href="#i-layers" /></svg>@T("Reports_TotalBatches")
            </div>
            <div class="mt-1.5 flex items-baseline gap-2">
                <span class="num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.TotalBatches</span>
                <span class="text-[11.5px] font-semibold text-ink-faint">@Loc.F("Reports_ExhaustedCount", Model.ExhaustedBatches)</span>
            </div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <svg class="icon !size-[15px] text-accent"><use href="#i-box" /></svg>@T("Reports_UnitsInWarehouses")
            </div>
            <div class="mt-1.5 num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.UnitsInWarehouses</div>
            <div class="mt-0.5 text-[11px] text-ink-faint">@T("Reports_RawUnitCount")</div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <svg class="icon !size-[15px] text-signal"><use href="#i-swap" /></svg>@T("Reports_TotalUnallocated")
            </div>
            <div class="mt-1.5 num text-[26px] font-bold tracking-[-.02em] text-signal">@Model.UnallocatedUnits</div>
            <div class="mt-0.5 text-[11px] text-ink-faint">@T("Reports_NeverPlaced")</div>
        </div>
    </div>

    <div class="rounded-lg border border-line bg-surface shadow-card">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line px-5 py-3">
            <span class="flex items-center gap-2.5 text-[14px] font-semibold text-ink">
                <svg class="icon !size-[18px] text-accent"><use href="#i-chart" /></svg>@T("Reports_TotalCost")
            </span>
            <span class="num text-[24px] font-bold tracking-[-.02em] text-ink">@Model.TotalInventoryCost.ToString("N2")</span>
        </div>
        <p class="px-5 py-3 text-[11.5px] text-ink-faint">@T("Reports_NoValuation")</p>
    </div>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <svg class="icon !size-[18px] text-accent"><use href="#i-chart" /></svg>
            <span class="text-[14px] font-semibold text-ink">@T("Reports_MovementTotals")</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@T("Common_Type")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Reports_Col_Movements")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Reports_Col_TotalUnits")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@T("Reports_Col_NetSigned")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (totals != null && totals.Any())
                    {
                        @foreach (var t in totals)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3">
                                    @if (IsIncoming(t.MovementType))
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@MoveType(t.MovementType)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-danger-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-danger">@MoveType(t.MovementType)</span>
                                    }
                                </td>
                                <td class="num px-4 py-3 text-end text-ink-soft">@t.MovementCount</td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@t.TotalQuantity</td>
                                <td class="num px-4 py-3 text-end font-semibold @(t.SignedQuantity < 0 ? "text-danger" : "text-ok")">@t.SignedQuantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="px-6 py-10 text-center text-[13.5px] text-ink-soft">@T("Reports_NoMovements")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-wrap gap-2">
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses"><svg class="icon !size-4"><use href="#i-store" /></svg>@T("Reports_WarehouseReports")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Products"><svg class="icon !size-4"><use href="#i-box" /></svg>@T("Reports_ZeroStockProducts")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Movements"><svg class="icon !size-4"><use href="#i-swap" /></svg>@T("Reports_MovementReports")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Balance"><svg class="icon !size-4"><use href="#i-chart" /></svg>@T("Reports_HistoricalBalance")</a>
    </div>
</section>
