@model Inventory.Contracts.DTOs.Reports.InventorySummaryDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = (Loc.IsEn ? "Inventory reports" : "تقارير المخزون");
    string MoveType(int t) => t switch
    {
        0 => (Loc.IsEn ? "Purchase in" : "إدخال شراء"),
        1 => (Loc.IsEn ? "Sale out" : "بيع خارج"),
        2 => (Loc.IsEn ? "Transfer in" : "تحويل داخل"),
        3 => (Loc.IsEn ? "Transfer out" : "تحويل خارج"),
        4 => (Loc.IsEn ? "Adjustment in" : "تسوية داخل"),
        5 => (Loc.IsEn ? "Adjustment out" : "تسوية خارج"),
        6 => (Loc.IsEn ? "Order return" : "إرجاع طلب"),
        _ => (Loc.IsEn ? "Purchase in" : "إدخال شراء")
    };
    bool IsIncoming(int t) => t == 0 || t == 2 || t == 4 || t == 6;
    var totals = (IEnumerable<MovementTypeTotalsDto>?)ViewBag.MovementTotals;

    const string btnGhost = "inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-line bg-surface px-4 text-[13.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
}

<section class="grid gap-5">
    <header class="border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@(Loc.IsEn ? "Inventory reports" : "تقارير المخزون")</h1>
        <p class="mt-1.5 text-[13.5px] text-ink-soft">@(Loc.IsEn ? $"Organization-scoped rollup, generated {Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm")} UTC." : $"تجميع شامل المؤسسة، أُنشئ في {Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm")} UTC.")</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <icon name="store" class="!size-[15px] text-accent" />@(Loc.IsEn ? "Warehouses" : "المستودعات")
            </div>
            <div class="mt-1.5 flex items-baseline gap-2">
                <span class="num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.TotalWarehouses</span>
                <span class="text-[11.5px] font-semibold text-ok">@(Loc.IsEn ? $"({Model.ActiveWarehouses} active)" : $"({Model.ActiveWarehouses} نشط)")</span>
            </div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <icon name="layers" class="!size-[15px] text-accent" />@(Loc.IsEn ? "Batches" : "الدفعات")
            </div>
            <div class="mt-1.5 flex items-baseline gap-2">
                <span class="num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.TotalBatches</span>
                <span class="text-[11.5px] font-semibold text-ink-faint">@(Loc.IsEn ? $"({Model.ExhaustedBatches} exhausted)" : $"({Model.ExhaustedBatches} مستنفدة)")</span>
            </div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <icon name="package" class="!size-[15px] text-accent" />@(Loc.IsEn ? "Units in warehouses" : "وحدات بالمستودعات")
            </div>
            <div class="mt-1.5 num text-[26px] font-bold tracking-[-.02em] text-ink">@Model.UnitsInWarehouses</div>
            <div class="mt-0.5 text-[11px] text-ink-faint">@(Loc.IsEn ? "raw unit count, not capacity" : "عدد وحدات خام، ليس سعة")</div>
        </div>
        <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
            <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                <icon name="arrow-left-right" class="!size-[15px] text-signal" />@(Loc.IsEn ? "Total unallocated" : "إجمالي غير المخصَّص")
            </div>
            <div class="mt-1.5 num text-[26px] font-bold tracking-[-.02em] text-signal">@Model.UnallocatedUnits</div>
            <div class="mt-0.5 text-[11px] text-ink-faint">@(Loc.IsEn ? "units never placed" : "وحدات لم تُوضع أبداً")</div>
        </div>
    </div>

    <div class="rounded-lg border border-line bg-surface shadow-card">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line px-5 py-3">
            <span class="flex items-center gap-2.5 text-[14px] font-semibold text-ink">
                <icon name="chart-column" class="!size-[18px] text-accent" />@(Loc.IsEn ? "Total inventory cost (recorded batch unit costs)" : "إجمالي تكلفة المخزون (تكاليف وحدات الدفعات المسجّلة)")
            </span>
            <span class="num text-[24px] font-bold tracking-[-.02em] text-ink">@Model.TotalInventoryCost.ToString("N2")</span>
        </div>
        <p class="px-5 py-3 text-[11.5px] text-ink-faint">@(Loc.IsEn ? "No FIFO / weighted-average valuation policy approved — traceable cost data only." : "لا توجد سياسة تقييم FIFO أو متوسط مرجّح معتمدة — بيانات تكلفة قابلة للتتبع فقط.")</p>
    </div>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <icon name="chart-column" class="!size-[18px] text-accent" />
            <span class="text-[14px] font-semibold text-ink">@(Loc.IsEn ? "Movement totals by type (all time)" : "إجماليات الحركات حسب النوع (كل الوقت)")</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Type" : "النوع")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Movements" : "الحركات")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Total units" : "إجمالي الوحدات")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Net signed" : "الصافي بالإشارة")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (totals != null && totals.Any())
                    {
                        @foreach (var t in totals)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3">
                                    @if (IsIncoming(t.MovementType))
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@MoveType(t.MovementType)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-danger-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-danger">@MoveType(t.MovementType)</span>
                                    }
                                </td>
                                <td class="num px-4 py-3 text-end text-ink-soft">@t.MovementCount</td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@t.TotalQuantity</td>
                                <td class="num px-4 py-3 text-end font-semibold @(t.SignedQuantity < 0 ? "text-danger" : "text-ok")">@t.SignedQuantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="px-6 py-10 text-center text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No movements recorded." : "لا توجد حركات مسجّلة.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-wrap gap-2">
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses"><icon name="store" class="!size-4" />@(Loc.IsEn ? "Warehouse reports" : "تقارير المستودعات")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Products"><icon name="package" class="!size-4" />@(Loc.IsEn ? "Zero-stock products" : "منتجات نفاد المخزون")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Movements"><icon name="arrow-left-right" class="!size-4" />@(Loc.IsEn ? "Movement reports" : "تقارير الحركات")</a>
        <a class="@btnGhost" asp-area="Inventory" asp-controller="Reports" asp-action="Balance"><icon name="chart-column" class="!size-4" />@(Loc.IsEn ? "Historical balance" : "الرصيد التاريخي")</a>
    </div>
</section>
