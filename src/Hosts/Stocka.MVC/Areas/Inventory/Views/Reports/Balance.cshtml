@model PaginatedResult<HistoricalBalanceDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Loc.T("Balance_Title");
    string T(string key) => Loc.T(key);
    var asOf = (DateTime)ViewBag.AsOf;
}

<div class="container-fluid py-4">
    <h2 class="mb-1">@T("Balance_Title")</h2>
    <p class="text-muted mb-3">
        @T("Balance_Sub")
    </p>

    <form method="get" class="row g-2 mb-3" asp-area="Inventory" asp-controller="Reports" asp-action="Balance">
        <div class="col-md-3"><input type="date" class="form-control" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" /></div>
        <div class="col-auto"><button class="btn btn-primary">@T("Balance_Recalculate")</button></div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table-hover mb-0 table align-middle">
                <thead class="table-light">
                    <tr><th class="ps-4">@T("Common_Product")</th><th>@T("Common_Warehouse")</th><th>@T("Balance_Col_Balance")</th><th>@T("Balance_Col_Considered")</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var b in Model.Items)
                         {
                             <tr>
                                 <td class="ps-4"><small>@b.ProductId</small></td>
                                 <td><small>@b.WarehouseId</small></td>
                                 <td>@b.Quantity</td>
                                 <td>@b.MovementsConsidered</td>
                             </tr>
                         }
                    }
                    else
                    {
                        <tr><td colspan="4" class="py-5 text-center text-muted">@T("Balance_Empty")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">@Loc.F("Common_PageOf", Model.Page, Model.TotalPages)</small>
        <div class="btn-group">
            <a asp-area="Inventory" asp-controller="Reports" asp-action="Balance" asp-route-asOf="@asOf.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")">@T("Common_Previous")</a>
            <a asp-area="Inventory" asp-controller="Reports" asp-action="Balance" asp-route-asOf="@asOf.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)"
               class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")">@T("Common_Next")</a>
        </div>
    </div>
    <div class="mb-5"></div>
</div>
