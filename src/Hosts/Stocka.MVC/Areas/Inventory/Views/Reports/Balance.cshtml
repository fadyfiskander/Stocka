@model PaginatedResult<HistoricalBalanceDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = (Loc.IsEn ? "Historical balance" : "الرصيد التاريخي");
    var asOf = (DateTime)ViewBag.AsOf;

    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string btnPrimary = "inline-flex h-10 items-center justify-center gap-1.5 rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover";
    const string pageBtn = "inline-flex h-8 items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink transition-colors hover:bg-sunken hover:no-underline";
    const string pageOff = "inline-flex h-8 cursor-not-allowed items-center justify-center rounded-md border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-faint opacity-45";
}

<section class="grid gap-5">
    <header class="border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@(Loc.IsEn ? "Historical balance" : "الرصيد التاريخي")</h1>
        <p class="mt-1.5 max-w-[80ch] text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Stock balance reconstructed from the movement audit trail as of a date (inclusive). Reliable from the first recorded movement onward — movements are never deleted or rewritten. Rows with zero balance are omitted." : "رصيد المخزون مُعاد بناؤه من سجل حركات التدقيق حتى تاريخ معيّن (شامل). موثوق من أول حركة مسجّلة فصاعداً — الحركات لا تُحذف ولا تُعاد كتابتها. تُحذف الصفوف ذات الرصيد صفري.")</p>
    </header>

    <form method="get" asp-area="Inventory" asp-controller="Reports" asp-action="Balance"
          class="flex flex-wrap items-end gap-3 rounded-lg border border-line bg-surface p-4 shadow-card">
        <div class="min-w-[200px]">
            <label for="asOf" class="mb-1.5 block text-[12.5px] font-semibold text-ink-soft">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</label>
            <input id="asOf" type="date" class="@input num font-mono" name="asOf" value="@asOf.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="@btnPrimary">
            <icon name="undo-2" class="!size-4" />@(Loc.IsEn ? "Recalculate" : "إعادة الحساب")
        </button>
    </form>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Product" : "المنتج")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Warehouse" : "المستودع")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Balance" : "الرصيد")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Movements considered" : "الحركات المُحتسبة")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var b in Model.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@b.ProductId</span></td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@b.WarehouseId</span></td>
                                <td class="num px-4 py-3 text-end text-[14px] font-bold text-ink">@b.Quantity</td>
                                <td class="num px-4 py-3 text-end text-ink-faint">@b.MovementsConsidered</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-14 text-center">
                                <icon name="chart-column" class="mx-auto !size-8 text-ink-faint" />
                                <p class="mt-2 text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No stock existed at this date." : "لا يوجد مخزون في هذا التاريخ.")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-[12.5px] text-ink-faint">@(Loc.IsEn ? $"Page {Model.Page} of {Model.TotalPages}" : $"صفحة {Model.Page} من {Model.TotalPages}")</span>
        <div class="flex items-center gap-1.5">
            @if (Model.HasPrevious)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Reports" asp-action="Balance" asp-route-asOf="@asOf.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)">
                    <icon name="chevron-left" class="!size-4 scale-x-[var(--dir-flip)]" />@(Loc.IsEn ? "Previous" : "السابق")
                </a>
            }
            else
            {
                <span class="@pageOff"><icon name="chevron-left" class="!size-4 scale-x-[var(--dir-flip)]" />@(Loc.IsEn ? "Previous" : "السابق")</span>
            }
            @if (Model.HasNext)
            {
                <a class="@pageBtn" asp-area="Inventory" asp-controller="Reports" asp-action="Balance" asp-route-asOf="@asOf.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)">
                    @(Loc.IsEn ? "Next" : "التالي")<icon name="chevron-right" class="!size-4 scale-x-[var(--dir-flip)]" />
                </a>
            }
            else
            {
                <span class="@pageOff">@(Loc.IsEn ? "Next" : "التالي")<icon name="chevron-right" class="!size-4 scale-x-[var(--dir-flip)]" /></span>
            }
        </div>
    </div>
</section>
