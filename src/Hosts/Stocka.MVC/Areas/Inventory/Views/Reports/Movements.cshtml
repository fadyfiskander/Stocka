@model IEnumerable<MovementTypeTotalsDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = (Loc.IsEn ? "Stock movement reports" : "تقارير حركات المخزون");
    string MoveType(int t) => t switch
    {
        0 => (Loc.IsEn ? "Purchase in" : "إدخال شراء"),
        1 => (Loc.IsEn ? "Sale out" : "بيع خارج"),
        2 => (Loc.IsEn ? "Transfer in" : "تحويل داخل"),
        3 => (Loc.IsEn ? "Transfer out" : "تحويل خارج"),
        4 => (Loc.IsEn ? "Adjustment in" : "تسوية داخل"),
        5 => (Loc.IsEn ? "Adjustment out" : "تسوية خارج"),
        6 => (Loc.IsEn ? "Order return" : "إرجاع طلب"),
        _ => (Loc.IsEn ? "Purchase in" : "إدخال شراء")
    };
    bool IsIncoming(int t) => t == 0 || t == 2 || t == 4 || t == 6;
    var from = (DateTime?)ViewBag.From;
    var to = (DateTime?)ViewBag.To;
    var inboundOutbound = (InboundOutboundSummaryDto?)ViewBag.InboundOutbound;
    var transfers = (PaginatedResult<TransferHistoryDto>?)ViewBag.TransferHistory;
    var adjustments = (PaginatedResult<Inventory.Contracts.DTOs.StockMovement.StockMovementDto>?)ViewBag.AdjustmentHistory;

    const string input = "block h-10 w-full rounded-md border border-line bg-surface px-3 text-[13.5px] text-ink outline-none transition hover:border-line-strong focus:border-accent focus:ring-[3px] focus:ring-[var(--focus-ring)]";
    const string btnPrimary = "inline-flex h-10 items-center justify-center gap-1.5 rounded-md bg-accent px-5 text-[13.5px] font-semibold text-on-accent transition-colors hover:bg-accent-hover";
}

<section class="grid gap-5">
    <header class="border-b border-line pb-5">
        <h1 class="text-[22px] font-bold tracking-[-.015em]">@(Loc.IsEn ? "Stock movement reports" : "تقارير حركات المخزون")</h1>
        <p class="mt-1.5 max-w-[80ch] text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Transfer pairs are reported once (out + in legs aggregated) — no double counting." : "أزواج التحويل تُعرض مرة واحدة (رجل الإدخال والإخراج مجمّعتان) — دون ازدواج.")</p>
    </header>

    <form method="get" asp-area="Inventory" asp-controller="Reports" asp-action="Movements"
          class="flex flex-wrap items-end gap-3 rounded-lg border border-line bg-surface p-4 shadow-card">
        <div class="min-w-[180px]">
            <label for="from" class="mb-1.5 block text-[12.5px] font-semibold text-ink-soft">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</label>
            <input id="from" type="date" class="@input num font-mono" name="from" value="@(from?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="min-w-[180px]">
            <label for="to" class="mb-1.5 block text-[12.5px] font-semibold text-ink-soft">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</label>
            <input id="to" type="date" class="@input num font-mono" name="to" value="@(to?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="@btnPrimary">
            <icon name="filter" class="!size-4" />@(Loc.IsEn ? "Apply" : "تطبيق")
        </button>
    </form>

    @if (inboundOutbound != null)
    {
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
                <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                    <icon name="arrow-down" class="!size-[15px] text-ok" />@(Loc.IsEn ? "Inbound units (net)" : "وحدات داخلة (صافي)")
                </div>
                <div class="num mt-1.5 text-[26px] font-bold tracking-[-.02em] text-ok">@inboundOutbound.InboundUnits</div>
            </div>
            <div class="rounded-lg border border-line bg-surface p-4 shadow-card">
                <div class="flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-soft">
                    <icon name="arrow-up" class="!size-[15px] text-danger" />@(Loc.IsEn ? "Outbound units (net)" : "وحدات خارجة (صافي)")
                </div>
                <div class="num mt-1.5 text-[26px] font-bold tracking-[-.02em] text-danger">@inboundOutbound.OutboundUnits</div>
            </div>
            <div class="rounded-lg border border-line bg-surface p-4 shadow-card sm:col-span-2 lg:col-span-1">
                <div class="text-[11.5px] font-semibold text-ink-soft">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</div>
                <div class="num mt-1.5 text-[13.5px] text-ink-soft">@(Loc.IsEn ? $"Date range {inboundOutbound.DateFromUtc.ToString("yyyy-MM-dd")} → {inboundOutbound.DateToUtc.ToString("yyyy-MM-dd")}. Transfer legs excluded (internal movements); see transfer history below." : $"نطاق التاريخ {inboundOutbound.DateFromUtc.ToString("yyyy-MM-dd")} ← {inboundOutbound.DateToUtc.ToString("yyyy-MM-dd")}. رجل التحويل مستثناة (حركات داخلية)؛ انظر سجل التحويلات أدناه.")</div>
            </div>
        </div>
    }

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <icon name="chart-column" class="!size-[18px] text-accent" />
            <span class="text-[14px] font-semibold text-ink">@(Loc.IsEn ? "Totals by movement type" : "الإجماليات حسب نوع الحركة")</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Type" : "النوع")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Movements" : "الحركات")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Units" : "الوحدات")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Net signed" : "الصافي بالإشارة")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="px-4 py-3">
                                    @if (IsIncoming(t.MovementType))
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@MoveType(t.MovementType)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-danger-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-danger">@MoveType(t.MovementType)</span>
                                    }
                                </td>
                                <td class="num px-4 py-3 text-end text-ink-soft">@t.MovementCount</td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@t.TotalQuantity</td>
                                <td class="num px-4 py-3 text-end font-semibold @(t.SignedQuantity < 0 ? "text-danger" : "text-ok")">@t.SignedQuantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="px-6 py-10 text-center text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No movements in this range." : "لا توجد حركات في هذا النطاق.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <icon name="arrow-left-right" class="!size-[18px] text-info" />
            <span class="text-[14px] font-semibold text-ink">@(Loc.IsEn ? "Transfer history (source → destination)" : "سجل التحويلات (المصدر ← الوجهة)")</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Transfer ref" : "مرجع التحويل")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Source" : "المصدر")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Destination" : "الوجهة")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Quantity" : "الكمية")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (transfers != null)
                    {
                        @foreach (var t in transfers.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="whitespace-nowrap px-4 py-3"><span class="num font-mono text-[12.5px] text-ink-soft" dir="ltr">@t.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</span></td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@t.TransferReferenceId</span></td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@t.SourceWarehouseId</span></td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-soft">@t.DestinationWarehouseId</span></td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@t.Quantity</td>
                            </tr>
                        }
                        if (!transfers.Items.Any())
                        {
                            <tr><td colspan="5" class="px-6 py-10 text-center text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No transfers recorded." : "لا توجد تحويلات مسجّلة.")</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-card">
        <div class="flex items-center gap-2.5 border-b border-line px-5 py-3">
            <icon name="undo-2" class="!size-[18px] text-signal" />
            <span class="text-[14px] font-semibold text-ink">@(Loc.IsEn ? "Adjustments, damage & reversals (with recorded reasons)" : "التسويات والتلف وعمليات العكس (مع الأسباب المسجّلة)")</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-[13.5px]">
                <thead>
                    <tr class="border-b border-line-strong bg-sunken/60 text-ink-soft">
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Date (UTC)" : "التاريخ (UTC)")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Type" : "النوع")</th>
                        <th class="px-4 py-2.5 text-end text-[11.5px] font-semibold">@(Loc.IsEn ? "Quantity" : "الكمية")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Reason" : "السبب")</th>
                        <th class="px-4 py-2.5 text-start text-[11.5px] font-semibold">@(Loc.IsEn ? "Reference" : "المرجع")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (adjustments != null)
                    {
                        @foreach (var m in adjustments.Items)
                        {
                            <tr class="border-b border-line last:border-0 hover:bg-sunken/50">
                                <td class="whitespace-nowrap px-4 py-3"><span class="num font-mono text-[12.5px] text-ink-soft" dir="ltr">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></td>
                                <td class="px-4 py-3">
                                    @if (m.MovementType == 4)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-ok-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-ok">@MoveType(m.MovementType)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-warn-tint px-2.5 py-0.5 text-[11.5px] font-semibold text-warn">@MoveType(m.MovementType)</span>
                                    }
                                </td>
                                <td class="num px-4 py-3 text-end font-semibold text-ink">@m.Quantity</td>
                                <td class="px-4 py-3 text-ink-soft">@m.Reason</td>
                                <td class="px-4 py-3"><span class="num break-all font-mono text-[12px] text-ink-faint">@(m.ReferenceId?.ToString() ?? "-")</span></td>
                            </tr>
                        }
                        if (!adjustments.Items.Any())
                        {
                            <tr><td colspan="5" class="px-6 py-10 text-center text-[13.5px] text-ink-soft">@(Loc.IsEn ? "No adjustments, write-offs or reversals recorded." : "لا توجد تسويات أو أشطاب أو عمليات عكس مسجّلة.")</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
