<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>472fc2ec-2db4-4450-8e7e-845497e6edaa</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>

    <!-- Tailwind CSS build integration (see the TailwindBuild target below).
         Set SkipTailwindBuild=true to skip it (e.g. on machines without Node/npm). -->
    <SkipTailwindBuild Condition="'$(SkipTailwindBuild)' == ''">false</SkipTailwindBuild>
    <TailwindInput>$(MSBuildProjectDirectory)\src\styles\tailwind.css</TailwindInput>
    <TailwindOutput>$(MSBuildProjectDirectory)\wwwroot\css\tailwind.css</TailwindOutput>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Areas\Account\Data\**" />
    <Compile Remove="Areas\Catalog\Data\**" />
    <Content Remove="Areas\Account\Data\**" />
    <Content Remove="Areas\Catalog\Data\**" />
    <EmbeddedResource Remove="Areas\Account\Data\**" />
    <EmbeddedResource Remove="Areas\Catalog\Data\**" />
    <None Remove="Areas\Account\Data\**" />
    <None Remove="Areas\Catalog\Data\**" />
  </ItemGroup>

  <!-- Tailwind rebuild triggers: templates and scripts that carry utility classes. -->
  <ItemGroup>
    <TailwindSources Include="Views\**\*.cshtml" />
    <TailwindSources Include="Areas\**\*.cshtml" />
    <TailwindSources Include="wwwroot\js\**\*.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Contracts\Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.Contracts\Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\Organization.Contracts\Organization.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\Organization.Infrastructure\Organization.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\icons\" />
  </ItemGroup>

  <!-- ============================================================
       Tailwind CSS
       Builds wwwroot/css/tailwind.css from src/styles/tailwind.css
       as part of `dotnet build`. Skipped when SkipTailwindBuild=true.
       ============================================================ -->
  <Target Name="TailwindBuild" BeforeTargets="Build;Publish" Inputs="$(TailwindInput);$(MSBuildProjectDirectory)\package.json;$(MSBuildProjectDirectory)\package-lock.json;@(TailwindSources)" Outputs="$(TailwindOutput)" Condition="'$(SkipTailwindBuild)' != 'true'">
    <Error Condition="!Exists('$(TailwindInput)')" Text="Tailwind input not found at $(TailwindInput)." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" Text="Tailwind dependencies are not installed. Run `npm install` in $(MSBuildProjectDirectory), or build with -p:SkipTailwindBuild=true to skip the CSS build." />

    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
