@{
    ViewData["Title"] = (Loc.IsEn ? "Dashboard" : "لوحة العمل");
}

<section class="grid gap-5">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
            <h1 class="font-bold tracking-[-.02em] text-[26px]">@(Loc.IsEn ? "Dashboard" : "لوحة العمل")</h1>
            <p class="mt-1.5 text-[13.5px] text-ink-soft">@(Loc.IsEn ? "A quick starting point to manage products, stock and reports." : "نقطة انطلاق سريعة لإدارة الأصناف والمخزون والتقارير.")</p>
        </div>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
        <a class="group/card shadow-card relative flex flex-col gap-3 overflow-hidden rounded-lg border border-line bg-surface p-5 transition hover:border-accent/45 hover:no-underline"
           asp-area="Catalog" asp-controller="Products" asp-action="Index">
            <span class="grid size-11 place-items-center rounded-lg bg-accent-tint text-accent">
                <icon name="package" class="!size-[22px]" />
            </span>
            <span class="font-semibold text-[15.5px] text-ink">@(Loc.IsEn ? "Catalog" : "الكتالوج")</span>
            <span class="leading-relaxed text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Add products and categories, and organize your sales data." : "أضف المنتجات والتصنيفات ونظّم بيانات البيع.")</span>
            <span class="mt-1 inline-flex items-center gap-1.5 font-semibold text-[13px] text-accent">
                @(Loc.IsEn ? "View products" : "عرض المنتجات")
                <icon name="chevron-right" class="!size-[15px] transition-transform group-hover/card:translate-x-0.5 rtl:group-hover/card:-translate-x-0.5 scale-x-[var(--dir-flip)]" />
            </span>
        </a>

        <a class="group/card shadow-card relative flex flex-col gap-3 overflow-hidden rounded-lg border border-line bg-surface p-5 transition hover:border-accent/45 hover:no-underline"
           asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">
            <span class="grid size-11 place-items-center rounded-lg bg-sunken text-ink-soft">
                <icon name="store" class="!size-[22px]" />
            </span>
            <span class="font-semibold text-[15.5px] text-ink">@(Loc.IsEn ? "Inventory" : "المخزون")</span>
            <span class="leading-relaxed text-[13.5px] text-ink-soft">@(Loc.IsEn ? "Review warehouses, batches and stock movements." : "راجع المستودعات والدفعات وحركة المخزون.")</span>
            <span class="mt-1 inline-flex items-center gap-1.5 font-semibold text-[13px] text-accent">
                @(Loc.IsEn ? "View warehouses" : "عرض المستودعات")
                <icon name="chevron-right" class="!size-[15px] transition-transform group-hover/card:translate-x-0.5 rtl:group-hover/card:-translate-x-0.5 scale-x-[var(--dir-flip)]" />
            </span>
        </a>
    </div>
</section>
