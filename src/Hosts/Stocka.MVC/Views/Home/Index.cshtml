@{
    ViewData["Title"] = Loc.T("Home_Title");
    string T(string key) => Loc.T(key);
}

<section class="page">
    <header class="page-head"><div><h1 class="page-title">@T("Home_Title")</h1><p class="page-sub">@T("Home_Sub")</p></div></header>
    <div class="grid-2">
        <article class="card"><div class="card-body"><h2 class="card-title">@T("Home_CatalogTitle")</h2><p class="page-sub">@T("Home_CatalogText")</p><a class="btn btn-primary" asp-area="Catalog" asp-controller="Products" asp-action="Index">@T("Home_CatalogLink")</a></div></article>
        <article class="card"><div class="card-body"><h2 class="card-title">@T("Home_InventoryTitle")</h2><p class="page-sub">@T("Home_InventoryText")</p><a class="btn btn-ghost" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">@T("Home_InventoryLink")</a></div></article>
    </div>
</section>
