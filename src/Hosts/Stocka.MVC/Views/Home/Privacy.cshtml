@{
    ViewData["Title"] = Loc.T("Privacy_Title");
    string T(string key) => Loc.T(key);
}

<article class="mx-auto max-w-[68ch] rounded-lg border border-line bg-surface p-6 shadow-card sm:p-8">
    <h1 class="text-[22px] font-bold tracking-[-.015em]">@T("Privacy_Title")</h1>
    <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">@T("Privacy_Body")</p>
</article>
