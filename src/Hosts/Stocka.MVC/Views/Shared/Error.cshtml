@model ErrorViewModel
@{
    ViewData["Title"] = Loc.T("Err_Title");
    string T(string key) => Loc.T(key);
}

<article class="mx-auto max-w-[64ch]">
    <div class="flex items-start gap-4 rounded-lg border border-danger/30 bg-danger-tint p-5 text-danger sm:p-6">
        <svg class="icon mt-0.5 !size-[26px] shrink-0"><use href="#i-alert" /></svg>
        <div class="min-w-0">
            <h1 class="text-[20px] font-bold tracking-[-.015em]">@T("Err_Heading")</h1>
            <p class="mt-1.5 text-[13.5px] leading-relaxed">@T("Err_Text")</p>
            @if (Model.ShowRequestId)
            {
                <p class="mt-3 text-[12.5px]">
                    <span class="font-semibold">@T("Err_RequestId")</span>
                    <code class="rounded border border-danger/25 bg-danger/5 px-1.5 py-0.5">@Model.RequestId</code>
                </p>
            }
        </div>
    </div>

    <section class="mt-4 rounded-lg border border-line bg-surface p-5 shadow-card sm:p-6">
        <h2 class="text-[15px] font-semibold text-ink">@T("Err_DevHeading")</h2>
        <p class="mt-2 text-[13.5px] leading-relaxed text-ink-soft">@T("Err_DevText1")</p>
        <p class="mt-2 text-[13.5px] leading-relaxed text-ink-soft">
            <strong class="text-ink">@T("Err_DevWarn")</strong>
            @T("Err_DevText2")
        </p>
    </section>
</article>
