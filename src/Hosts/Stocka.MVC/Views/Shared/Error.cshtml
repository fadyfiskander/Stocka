@model ErrorViewModel
@{
    ViewData["Title"] = Loc.T("Err_Title");
    string T(string key) => Loc.T(key);
}

<h1 class="text-danger">@T("Err_Heading")</h1>
<h2 class="text-danger">@T("Err_Text")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T("Err_RequestId")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T("Err_DevHeading")</h3>
<p>
    @T("Err_DevText1")
</p>
<p>
    <strong>@T("Err_DevWarn")</strong>
    @T("Err_DevText2")
</p>
