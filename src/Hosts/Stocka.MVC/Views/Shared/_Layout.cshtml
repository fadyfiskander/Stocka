    <a class="sr-only focus:text-on-accent focus:not-sr-only focus:fixed focus:start-4 focus:top-3 focus:z-100 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2.5 focus:font-semibold"
       href="#content">@(Loc.IsEn ? "Skip to content" : "انتقل إلى المحتوى")</a>

    <div class="group/shell grid min-h-dvh grid-cols-1 bg-bg lg:grid-cols-[var(--aside-w)_minmax(0,1fr)] data-[rail=true]:lg:grid-cols-[var(--aside-w-rail)_minmax(0,1fr)]"
         id="shell" data-nav-open="false">

        @* ============ Sidebar ============ *@
        <aside class="border-aside-line text-aside-ink z-40 flex flex-col overflow-y-auto overscroll-contain border-e bg-aside group-data-[nav-open=true]/shell:max-lg:shadow-drawer group-data-[nav-open=true]/shell:max-lg:translate-x-0 lg:sticky lg:top-0 lg:h-dvh max-lg:fixed max-lg:inset-y-0 max-lg:start-0 max-lg:w-[min(300px,86vw)] max-lg:translate-x-[var(--drawer-x)] max-lg:transition-transform max-lg:duration-200"
               id="sidebar" aria-label="@(Loc.IsEn ? "Main navigation" : "التنقل الرئيسي")">
            <a class="text-aside-ink flex min-h-14 items-center gap-2.5 px-4 py-3.5 hover:text-aside-ink lg:group-data-[rail=true]/shell:border-aside-line lg:group-data-[rail=true]/shell:justify-center lg:group-data-[rail=true]/shell:border-b lg:group-data-[rail=true]/shell:px-3"
               asp-area="" asp-controller="Home" asp-action="Index">
                <span class="text-aside-accent grid size-9 shrink-0 place-items-center rounded-[10px] bg-white/10">
                    <svg class="icon !size-5 !stroke-2"><use href="#i-box" /></svg>
                </span>
                <span class="grid leading-[1.15] lg:group-data-[rail=true]/shell:hidden">
                    <b class="font-semibold tracking-[.01em] text-[15.5px]">Stocka</b>
                    <span class="text-[11px] text-aside-soft">@(Loc.IsEn ? "Inventory control" : "إدارة المخزون")</span>
                </span>
            </a>

            <nav class="grid flex-1 content-start gap-1 px-2.5 pt-1 pb-4">
                <a class="@navLink @NavActive("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="icon text-aside-accent/80"><use href="#i-home" /></svg><span class="@navText">@(Loc.IsEn ? "Home" : "الرئيسية")</span>
                </a>

                <span class="@groupLabel" aria-hidden="true">@(Loc.IsEn ? "Catalog" : "المنتجات")</span>
                <a class="@navLink @NavActive("Catalog", "Products")" asp-area="Catalog" asp-controller="Products" asp-action="Index">
                    <svg class="icon text-aside-accent/80"><use href="#i-box" /></svg><span class="@navText">@(Loc.IsEn ? "Products" : "المنتجات")</span>
                </a>
                <a class="@navLink @NavActive("Catalog", "Categories")" asp-area="Catalog" asp-controller="Categories" asp-action="Index">
                    <svg class="icon text-aside-accent/80"><use href="#i-tag" /></svg><span class="@navText">@(Loc.IsEn ? "Categories" : "التصنيفات")</span>
                </a>

                <span class="@groupLabel" aria-hidden="true">@(Loc.IsEn ? "Inventory" : "المخزون")</span>
                <a class="@navLink @NavActive("Inventory", "Warehouses")" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">
                    <svg class="icon text-aside-accent/80"><use href="#i-store" /></svg><span class="@navText">@(Loc.IsEn ? "Warehouses" : "المستودعات")</span>
                </a>
                <a class="@navLink @NavActive("Inventory", "Batches")" asp-area="Inventory" asp-controller="Batches" asp-action="Index">
                    <svg class="icon text-aside-accent/80"><use href="#i-layers" /></svg><span class="@navText">@(Loc.IsEn ? "Batches" : "الدفعات")</span>
                </a>
                <a class="@navLink @NavActive("Inventory", "Stock", "Movements")" asp-area="Inventory" asp-controller="Stock" asp-action="Movements">
                    <svg class="icon text-aside-accent/80"><use href="#i-swap" /></svg><span class="@navText">@(Loc.IsEn ? "Movements" : "الحركات")</span>
                </a>

                <details class="nav-group rounded-md @(NavGroupActive("Inventory", "Reports") ? "is-open" : "")">
                    <summary title="@(Loc.IsEn ? "Reports" : "التقارير")" aria-label="@(Loc.IsEn ? "Reports" : "التقارير")"
                             class="relative flex cursor-pointer list-none items-center justify-between gap-2 rounded-md px-2.5 py-2 font-semibold tracking-wide text-[11px] text-aside-soft transition-colors select-none hover:text-aside-ink hover:bg-white/[0.055] lg:group-data-[rail=true]/shell:justify-center lg:group-data-[rail=true]/shell:px-0 [&::-webkit-details-marker]:hidden">
                        <span class="@navText">@(Loc.IsEn ? "Reports" : "التقارير")</span>
                        <svg class="icon !size-[13px] transition-transform duration-150 group-open:rotate-180 lg:group-data-[rail=true]/shell:hidden"><use href="#i-chevron-down" /></svg>
                    </summary>
                    <div class="grid gap-1 pb-1">
                        <a class="@navLink @NavActive("Inventory", "Reports", "Index")" asp-area="Inventory" asp-controller="Reports" asp-action="Index">
                            <span class="@navText">@(Loc.IsEn ? "Overview" : "نظرة عامة")</span>
                        </a>
                        <a class="@navLink @NavActive("Inventory", "Reports", "Balance")" asp-area="Inventory" asp-controller="Reports" asp-action="Balance">
                            <span class="@navText">@(Loc.IsEn ? "Balance" : "الرصيد")</span>
                        </a>
                        <a class="@navLink @NavActive("Inventory", "Reports", "Movements")" asp-area="Inventory" asp-controller="Reports" asp-action="Movements">
                            <span class="@navText">@(Loc.IsEn ? "Movement report" : "تقرير الحركات")</span>
                        </a>
                        <a class="@navLink @NavActive("Inventory", "Reports", "Products")" asp-area="Inventory" asp-controller="Reports" asp-action="Products">
                            <span class="@navText">@(Loc.IsEn ? "Zero stock" : "نفاد المخزون")</span>
                        </a>
                        <a class="@navLink @NavActive("Inventory", "Reports", "Warehouses")" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses">
                            <span class="@navText">@(Loc.IsEn ? "Warehouse reports" : "تقارير المستودعات")</span>
                        </a>
                    </div>
                </details>
            </nav>

            <div class="border-aside-line flex items-center justify-end border-t px-3.5 py-3 max-lg:hidden lg:group-data-[rail=true]/shell:justify-center">
                <button type="button"
                        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-aside-soft transition-colors hover:text-aside-ink hover:bg-white/[0.055]"
                        data-rail-toggle aria-label="@(Loc.IsEn ? "Collapse navigation" : "طي القائمة")" title="@(Loc.IsEn ? "Collapse navigation" : "طي القائمة")">
                    <svg class="icon !size-[17px] scale-x-[var(--dir-flip)] group-data-[rail=true]/shell:scale-x-[calc(var(--dir-flip)*-1)]"><use href="#i-chevrons" /></svg>
                </button>
            </div>
        </aside>

        <div class="backdrop-blur-[1.5px] pointer-events-none fixed inset-0 z-50 bg-[rgba(10,16,12,.46)] opacity-0 transition-opacity duration-200 group-data-[nav-open=true]/shell:pointer-events-auto group-data-[nav-open=true]/shell:opacity-100 lg:hidden"
             data-nav-close></div>

        @* ============ Frame ============ *@
        <div class="flex min-w-0 flex-col">
            <header class="sticky top-0 z-30 flex min-h-[58px] items-center gap-2.5 border-b border-line bg-bg/85 px-6 py-2 backdrop-blur-md max-lg:px-4">
                <button type="button" class="@toolBtn lg:hidden" data-nav-toggle aria-label="@(Loc.IsEn ? "Open navigation" : "فتح القائمة")">
                    <svg class="icon !size-[19px]"><use href="#i-menu" /></svg>
                </button>

                <a class="hidden items-center gap-2 font-semibold text-[15px] text-ink hover:no-underline max-lg:inline-flex"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="grid size-[26px] place-items-center rounded-[7px] bg-accent-tint text-accent">
                        <svg class="icon !size-[15px]"><use href="#i-box" /></svg>
                    </span>
                    Stocka
                </a>

                <form class="flex h-9 w-[min(340px,42vw)] items-center gap-2 rounded-md border border-line bg-surface px-3 text-ink-faint transition focus-within:border-accent focus-within:ring-[var(--focus-ring)] focus-within:ring-[3px] max-lg:hidden"
                      role="search" method="get"
                      asp-area="Catalog" asp-controller="Products" asp-action="SearchByName">
                    <svg class="icon !size-[17px]"><use href="#i-search" /></svg>
                    <input type="search" name="name" autocomplete="off" placeholder="@(Loc.IsEn ? "Search products" : "ابحث عن منتج")" aria-label="@(Loc.IsEn ? "Search products" : "ابحث عن منتج")"
                           class="min-w-0 flex-1 border-0 bg-transparent text-[13.5px] text-ink outline-none placeholder:text-ink-faint" />
                </form>

                <div class="ms-auto flex items-center gap-2">
                    <a class="inline-flex h-9 items-center gap-1.5 rounded-full border border-line bg-surface px-3 font-semibold text-[12.5px] text-ink-soft transition-colors hover:border-accent hover:text-accent hover:no-underline"
                       asp-controller="Localization" asp-action="SetLanguage"
                       asp-route-culture="@other" asp-route-returnUrl="@returnUrl"
                       title="@(Loc.IsEn ? "Switch to Arabic" : "التبديل إلى الإنجليزية")">
                        <svg class="icon !size-[15px]"><use href="#i-globe" /></svg>
                        <span>@otherLabel</span>
                    </a>
                    <button type="button" class="@toolBtn"
                            data-theme-toggle
                            data-aria-label-light="@(Loc.IsEn ? "Light theme" : "الوضع الفاتح")" data-aria-label-dark="@(Loc.IsEn ? "Dark theme" : "الوضع الداكن")"
                            aria-label="@(Loc.IsEn ? "Dark theme" : "الوضع الداكن")">
                        <svg class="icon hidden !size-[19px] dark:inline-block"><use href="#i-sun" /></svg>
                        <svg class="icon hidden !size-[19px] light:inline-block"><use href="#i-moon" /></svg>
                    </button>
                </div>
            </header>

            <main class="bg-grid w-full flex-1" id="content">
                <div class="mx-auto w-full max-w-[1280px] px-6 pt-6 pb-14 max-lg:px-4">
                    <partial name="_Flash" />
                    @RenderBody()
                </div>
            </main>

            <footer class="flex flex-wrap items-center gap-4 border-t border-line px-6 pt-4 pb-6 text-[12.5px] text-ink-faint max-lg:px-4">
                <span>© Stocka</span>
                <span class="ms-auto">@(Loc.IsEn ? "Business operations system" : "نظام إدارة الأعمال")</span>
            </footer>
        </div>
    </div>

    <script type="application/json" id="stocka-i18n">@Json.Serialize(i18n)</script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
